#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --analysis-only && "$1" != --import-tools-only && "$1" != --import ) ]]; then
  echo 'Usage: .agents/setup [--analysis-only|--import-tools-only|--import]' >&2
  exit 2
fi
analysis_only="${1:-}"
if [[ $# -eq 0 && -f .amp/orb-profile ]] && [[ "$(cat .amp/orb-profile)" == import ]]; then
  analysis_only=--import
fi

step() {
  local label="$1"
  shift
  echo "[orb-setup] $label"
  time "$@"
}

# The analysis-only preparation lane must not depend on Desktop, OCR, databases,
# CI users or renderer installation. Full setup preserves its existing checks.
if [[ "$analysis_only" != --analysis-only ]]; then
required_packages=(
  ffmpeg
  fonts-liberation
  fonts-noto-cjk
  ghostscript
  imagemagick
  libreoffice-writer
  poppler-utils
  python3-numpy
  python3-scipy
  python3-venv
  sqlite3
  tesseract-ocr
  tesseract-ocr-chi-sim
  tesseract-ocr-eng
  unzip
  util-linux
  zip
)
missing_packages=()
for package in "${required_packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing_packages+=("$package")
  fi
done

if ((${#missing_packages[@]})); then
  step "refreshing apt metadata" sudo apt-get update
  step "installing system tools: ${missing_packages[*]}" \
    sudo apt-get install -y "${missing_packages[@]}"
else
  echo "[orb-setup] system tools already installed"
fi

if ! command -v magick >/dev/null 2>&1; then
  echo "[orb-setup] installing ImageMagick 6 compatibility command"
  sudo tee /usr/local/bin/magick >/dev/null <<'EOF'
#!/bin/sh
if [ "${1:-}" = identify ]; then
  shift
  exec /usr/bin/identify "$@"
fi
exec /usr/bin/convert "$@"
EOF
  sudo chmod 755 /usr/local/bin/magick
fi

image_magick_policy="$(find /etc/ImageMagick-* -name policy.xml -print -quit 2>/dev/null || true)"
if [[ -n "$image_magick_policy" ]] && grep -Fq 'rights="none" pattern="PDF"' "$image_magick_policy"; then
  step "enabling verification-only ImageMagick PDF policy" \
    sudo sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' "$image_magick_policy"
fi
fi

node_home="$HOME/.local/node-24"
if [[ ! -x "$node_home/bin/node" ]] || [[ "$($node_home/bin/node --version)" != v24.* ]]; then
  node_archive="$(curl -fsSL https://nodejs.org/dist/latest-v24.x/SHASUMS256.txt \
    | awk '/linux-x64\.tar\.xz$/ { print $2; exit }')"
  node_url="https://nodejs.org/dist/latest-v24.x/$node_archive"
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT
  step "downloading Node.js 24" curl -fsSLo "$temp_dir/$node_archive" "$node_url"
  curl -fsSLo "$temp_dir/SHASUMS256.txt" "${node_url%/*}/SHASUMS256.txt"
  (cd "$temp_dir" && grep "  $node_archive\$" SHASUMS256.txt | sha256sum --check --status)
  rm -rf "$node_home"
  mkdir -p "$node_home"
  step "installing Node.js 24" tar -xJf "$temp_dir/$node_archive" --strip-components=1 -C "$node_home"
  rm -rf "$temp_dir"
  trap - EXIT
else
  echo "[orb-setup] Node.js $($node_home/bin/node --version) already installed"
fi

profile_marker="# english-question-bank Node.js 24"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# english-question-bank Node.js 24
export PATH="$HOME/.local/node-24/bin:$PATH"
EOF
fi
export PATH="$node_home/bin:$PATH"

if [[ "$analysis_only" == --analysis-only ]]; then
  step "installing locked analysis dependencies" npm ci --prefix server --no-audit --no-fund
  step "checking the project Ajv 2020 runtime" node --input-type=module -e \
    "import {createRequire} from 'node:module'; const r=createRequire(new URL('./server/package.json', import.meta.url)); const Ajv=r('ajv/dist/2020.js').default; new Ajv().compile({type:'object'}); console.log('Ajv '+r('ajv/package.json').version+' ready');"
  echo "[orb-setup] analysis ready: $(node --version); full OCR/ASR/rendering setup not run"
  exit 0
fi

import_python="$HOME/.local/share/eqbank-import-python"
if [[ ! -x "$import_python/bin/python3" ]]; then
  step "preparing signal Python with system packages" /usr/bin/python3 -m venv --system-site-packages "$import_python"
fi
import_profile_marker="# english-question-bank signal Python for import and verification"
if ! grep -Fqx "$import_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$import_profile_marker
if [[ "\$PWD" == "$repo_root" || "\$PWD" == "$repo_root/"* ]]; then
  export PATH="\$HOME/.local/share/eqbank-import-python/bin:\$PATH"
fi
EOF
fi
export PATH="$import_python/bin:$PATH"
step "checking signal audio dependencies" python3 -c 'import numpy, scipy; print("signal audio ready")'

if [[ "$analysis_only" == --import ]]; then
  step "activating pnpm 10.28.1" corepack enable
  step "preparing pnpm 10.28.1" corepack prepare pnpm@10.28.1 --activate
  step "installing locked preview dependencies" env CI=true pnpm -C app install --frozen-lockfile
  step "installing locked import dependencies" npm ci --prefix server --no-audit --no-fund
  step "preparing preview Chromium" pnpm -C app exec playwright install --with-deps --no-shell chromium
  step "checking English and Simplified Chinese OCR data" bash -c \
    "tesseract --list-langs 2>/dev/null | grep -Fxq eng && tesseract --list-langs 2>/dev/null | grep -Fxq chi_sim"
  step "checking import environment" node --input-type=module -e \
    "const {checkImportEnvironment}=await import('./scripts/import-pipeline/import-environment-preflight.mjs'); checkImportEnvironment(); await import('./server/import-review/revisionProjection.mjs'); console.log('import and preview runtime ready');"
  echo "[orb-setup] import ready; no ASR model, CI user, development database or services initialized"
  exit 0
fi

listening_asr_home="$HOME/.local/share/eqbank-listening-asr"
listening_asr_python="$listening_asr_home/bin/python"
listening_asr_version="1.2.1"
ctranslate2_version="4.8.2"
listening_asr_model="Systran/faster-whisper-small.en"
listening_asr_revision="d1d751a5f8271d482d14ca55d9e2deeebbae577f"
if ! "$listening_asr_python" -c \
  "import importlib.metadata; assert importlib.metadata.version('faster-whisper') == '$listening_asr_version'; assert importlib.metadata.version('ctranslate2') == '$ctranslate2_version'" \
  >/dev/null 2>&1; then
  rm -rf "$listening_asr_home"
  step "creating the listening ASR Python environment" python3 -m venv "$listening_asr_home"
  step "installing locked listening ASR dependencies" \
    "$listening_asr_home/bin/pip" install --disable-pip-version-check \
      "faster-whisper==$listening_asr_version" "ctranslate2==$ctranslate2_version"
else
  echo "[orb-setup] faster-whisper $listening_asr_version and ctranslate2 $ctranslate2_version already installed"
fi
step "caching the pinned default listening ASR model" "$listening_asr_python" -c \
  "from pathlib import Path; from huggingface_hub import snapshot_download; p=Path(snapshot_download('$listening_asr_model', revision='$listening_asr_revision')); r=p.parent.parent/'refs'/'main'; r.parent.mkdir(exist_ok=True); r.write_text('$listening_asr_revision')"
step "checking offline loading of the default listening ASR model" env HF_HUB_OFFLINE=1 "$listening_asr_python" -c \
  "from faster_whisper import WhisperModel; WhisperModel('small.en', device='cpu', compute_type='int8', local_files_only=True); print('small.en offline cache ready')"
step "checking English and Simplified Chinese OCR data" bash -c \
  "tesseract --list-langs 2>/dev/null | grep -Fxq eng && tesseract --list-langs 2>/dev/null | grep -Fxq chi_sim"

if [[ "$analysis_only" == --import-tools-only ]]; then
  step "installing locked import dependencies" npm ci --prefix server --no-audit --no-fund
  step "checking import runtime modules" node --input-type=module -e \
    "await import('./server/paper-import-ai/publicSearchMetadata.mjs'); await import('./server/import-review/revisionProjection.mjs'); console.log('import runtime ready');"
  echo "[orb-setup] import tools ready: OCR eng+chi_sim; ASR model $listening_asr_model@$listening_asr_revision"
  exit 0
fi

ci_user="eqb-ci"
ci_root="/var/tmp/eqb-amp-ci"
if ! id -u "$ci_user" >/dev/null 2>&1; then
  step "creating the unprivileged Amp Orb CI user" \
    sudo useradd --system --user-group --home-dir "$ci_root/home" --shell /usr/sbin/nologin "$ci_user"
fi
for directory in \
  "$ci_root" \
  "$ci_root/cache" \
  "$ci_root/cache/corepack" \
  "$ci_root/cache/ms-playwright" \
  "$ci_root/cache/npm" \
  "$ci_root/home" \
  "$ci_root/inbox" \
  "$ci_root/runs" \
  "$ci_root/tmp"; do
  sudo install -d -o "$ci_user" -g "$ci_user" -m 0700 "$directory"
done

step "activating pnpm 10.28.1" corepack enable
step "preparing pnpm 10.28.1" corepack prepare pnpm@10.28.1 --activate
step "installing app dependencies" pnpm -C app install --frozen-lockfile
step "installing server dependencies" npm ci --prefix server

if compgen -G "$HOME/.cache/ms-playwright/chromium-*/chrome-linux*/chrome" >/dev/null; then
  step "checking Playwright Chromium" pnpm -C app exec playwright install --no-shell chromium
else
  step "installing Playwright Chromium and host dependencies" \
    pnpm -C app exec playwright install --with-deps --no-shell chromium
fi

step "initializing the local question bank" bash scripts/init-db.sh
echo "[orb-setup] ready: $(node --version), pnpm $(pnpm --version), npm $(npm --version)"
