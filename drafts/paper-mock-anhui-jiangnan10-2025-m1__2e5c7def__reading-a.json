        },
        {
          "sentenceId": "sentence-group:paper-mock-anhui-jiangnan10-2025-m1:reading-a-2",
          "paragraphId": "block:paper-mock-anhui-jiangnan10-2025-m1:reading-a:8",
          "sourceText": "You can join our hosts for a special tour of the Wildlife Photographer of the Year exhibition(available from 9:00 am to 9:45 am) and discover the stories and details that didn’t make it into the captions(说明文字).",
          "displayText": "You can join our hosts for a special tour of the Wildlife Photographer of the Year exhibition(available from 9:00 am to 9:45 am) and discover the stories and details that didn’t make it into the captions(说明文字).",
          "relatedQuestionIds": [
