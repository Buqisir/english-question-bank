            "translationRanges": [
              {
                "textId": "tr-grammar",
                "paragraphId": "tr-block:paper-mock-shanxi-taiyuan-2025-m1:grammar-fill:2",
                "start": 0,
                "end": 71,
                "quote": "在哈尔滨，吸引我们目光、令我们惊叹不已的东西，是这里的冰雕。它们不只是冰冻的艺术品，更是人类智慧的象征，证明了即使在极寒之中，美也能蓬勃绽放。"
              }
            ]
