            ],
            "translationRanges": [
              {
                "textId": "translation:group:paper-gaokao-2024-i:grammar-fill",
                "paragraphId": "translation:block:paper-gaokao-2024-i:grammar-fill:3",
                "start": 0,
                "end": 59,
                "quote": "此外，温室周围的丝绸之路花园带游客踏上一段受古丝绸之路启发的旅程。丝绸以及许多植物品种都是经由这条古道首次传入英国的。"
              }
            ]
