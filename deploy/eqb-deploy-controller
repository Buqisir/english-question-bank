#!/bin/sh
set -eu
umask 077

unset SSH_AUTH_SOCK

[ "${1-}" = -- ] || exit 64
shift
controller_module=/opt/eqb/deployments/host-configuration/current/deploy/eqb-deploy-controller.mjs
if [ "$#" -eq 1 ] && [ "$1" = preflight ]; then
  original_command=preflight
else
  [ "${1-}" = deploy ] || exit 64
  case "${2-}" in ''|*[!a-f0-9]*) exit 64 ;; esac
  [ "${#2}" -eq 40 ] || exit 64
  if [ "$#" -eq 2 ]; then
    original_command="deploy $2"
  elif [ "$#" -eq 4 ]; then
    case "$3" in code-only|migrate) ;; *) exit 64 ;; esac
    case "$4" in ''|*[!a-f0-9]*) exit 64 ;; esac
    [ "${#4}" -eq 64 ] || exit 64
    original_command="deploy $2 $3 $4"
  else
    exit 64
  fi
fi

# Readonly operations must be callable while maintenance owns the lock. They
# cannot dispatch recovery or mutation and are also used for local route proof.
if [ "${original_command%% *}" = preflight ]; then
  exec /usr/bin/env -i SSH_ORIGINAL_COMMAND="$original_command" \
    PATH=/usr/local/bin:/usr/bin:/bin /usr/bin/node --no-addons "$controller_module"
fi

IFS= read -r nonce </proc/sys/kernel/random/uuid
case "$nonce" in
  ''|*[!a-f0-9-]*) exit 70 ;;
esac
[ "${#nonce}" -eq 36 ] || exit 70
unit="eqb-deploy-$nonce"

status=0
/usr/bin/systemd-run \
  --quiet \
  --wait \
  --collect \
  --unit="$unit" \
  --property=Type=exec \
  --property=UMask=0077 \
  --property=KillMode=control-group \
  --property=StandardInput=null \
  --property=StandardOutput=journal \
  --property=StandardError=journal \
  -- \
  /usr/bin/flock \
    --exclusive \
    --nonblock \
    --conflict-exit-code 75 \
    /opt/eqb/deployments/deploy.lock \
    /usr/bin/env -i \
    SSH_ORIGINAL_COMMAND="$original_command" \
    PATH=/usr/local/bin:/usr/bin:/bin \
    /usr/bin/node --no-addons --input-type=module -e '
      import { lstatSync } from "node:fs";
      import { spawnSync } from "node:child_process";
      if (process.env.SSH_ORIGINAL_COMMAND !== "preflight") {
        const directory = lstatSync("/opt/eqb/deployments");
        if (!directory.isDirectory() || directory.uid !== process.getuid()
          || directory.gid !== process.getgid() || (directory.mode & 0o022)) {
          throw new Error("Unsafe barrier directory");
        }
        let absent = false;
        try { lstatSync("/opt/eqb/deployments/root-dispatch-barrier.json"); }
        catch (error) { if (error.code !== "ENOENT") throw error; absent = true; }
        if (!absent) {
          process.stderr.write("ROOT_DISPATCH_BARRIER_PRESENT\n");
          process.exit(70);
        }
      }
      const result = spawnSync("/usr/bin/node", ["--no-addons", process.argv[1]], {
        stdio: "inherit", env: process.env,
      });
      process.exit(result.status ?? 70);
    ' "$controller_module" \
  || status=$?

/usr/bin/journalctl --sync
/usr/bin/journalctl \
  --quiet \
  --no-pager \
  --output=cat \
  "_SYSTEMD_UNIT=$unit.service" \
  PRIORITY=6
exit "$status"
