#!/bin/bash
set -euo pipefail
umask 077
# Root-console/TAT only. Never installed as an SSH or sudo subcommand.
[[ $(id -u) == 0 && $(id -g) == 0 && ( $# == 1 || $# == 3 ) ]] || exit 64
target=$1
[[ $target =~ ^[0-9a-f]{40}$ ]] || exit 64
if [[ $# == 3 ]]; then
  [[ $2 == reconcile && $3 =~ ^[0-9a-f]{40}$ ]] || exit 64
fi
directory=/opt/eqb/deployments/host-upgrade-payload-$target/deploy
[[ $0 == "$directory/upgrade-eqb-host-configuration-once" ]] || exit 64
for parent in / /opt /opt/eqb /opt/eqb/deployments \
  "/opt/eqb/deployments/host-upgrade-payload-$target" "$directory"; do
  [[ -d $parent && ! -L $parent ]] || exit 70
  [[ $(stat -c '%u:%g' "$parent") == 0:0 ]] || exit 70
  mode=$(stat -c '%a' "$parent")
  (( (8#$mode & 0022) == 0 )) || exit 70
done
for file in "$directory/upgrade-eqb-host-configuration-once" "$directory/upgrade-eqb-host-configuration-once.mjs"; do
  [[ -f $file && ! -L $file && $(stat -c '%u:%g:%a:%h' "$file") == 0:0:600:1 ]] || exit 70
done
lock=/opt/eqb/deployments/deploy.lock
[[ -f $lock && ! -L $lock && $(stat -c '%u:%g:%a:%h' "$lock") == 0:0:600:1 ]] || exit 70
exec 9< "$lock"
/usr/bin/flock --exclusive --nonblock --conflict-exit-code 75 9 || exit $?
[[ $(stat -Lc '%d:%i' /proc/self/fd/9) == $(stat -Lc '%d:%i' "$lock") ]] || exit 70
exec /usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin \
  GIT_NO_REPLACE_OBJECTS=1 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
  /usr/bin/node --no-addons "$directory/upgrade-eqb-host-configuration-once.mjs" "$@"
