# Caddy config installed only after the immutable release-layout bootstrap.

eqbank.cc, www.eqbank.cc {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /paper-assets/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /user-space/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /ops {
		redir /ops/ 308
	}

	handle_path /ops/* {
		root * /opt/eqb/current/import-ops/public
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	handle /assets/* {
		root * /opt/eqb/current/app/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /opt/eqb/current/app/dist
		try_files {path} /index.html
		file_server
	}
}
