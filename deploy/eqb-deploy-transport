#!/bin/sh
set -eu

# This root-owned wrapper runs as the unprivileged SSH transport account. The
# authorized_keys forced command prevents choosing another executable; this
# parser prevents SSH_ORIGINAL_COMMAND from becoming shell syntax or sudo argv.

original_command=${SSH_ORIGINAL_COMMAND-}
unset SSH_AUTH_SOCK

case "$original_command" in
  preflight)
    exec /usr/bin/sudo -n /usr/local/libexec/eqb-deploy-controller-v1 -- preflight
    ;;
  'status '*)
    command_name=status
    arguments=${original_command#status }
    ;;
  'deploy '*)
    command_name=deploy
    arguments=${original_command#deploy }
    ;;
  'deploy-reviewed-persistence '*)
    command_name=deploy-reviewed-persistence
    arguments=${original_command#deploy-reviewed-persistence }
    ;;
  'update-host-config '*)
    command_name=update-host-config
    arguments=${original_command#update-host-config }
    ;;
  *) exit 64 ;;
esac

transaction=${arguments%% *}
case "$transaction" in
  ????????-????-4???-[89ab]???-????????????) ;;
  *) exit 64 ;;
esac
case "$transaction" in *[!a-f0-9-]*) exit 64 ;; esac
if [ "$command_name" = status ]; then
  [ "$arguments" = "$transaction" ] || exit 64
  # Reuse the existing bounded deploy sudo grant; the fixed root parser maps
  # this non-SHA sentinel to readonly status, never to deployment/recovery.
  exec /usr/bin/sudo -n /usr/local/libexec/eqb-deploy-controller-v1 -- deploy "$transaction" status
fi
[ "$arguments" != "$transaction" ] || exit 64
arguments=${arguments#* }
sha=${arguments%% *}
case "$sha" in
  ''|*[!a-f0-9]*) exit 64 ;;
esac
[ "${#sha}" -eq 40 ] || exit 64

if [ "$command_name" = deploy ]; then
  [ "$arguments" = "$sha" ] || exit 64
  exec /usr/bin/sudo -n /usr/local/libexec/eqb-deploy-controller-v1 -- deploy "$transaction" "$sha"
fi

digest=${arguments#* }
[ "$arguments" = "$sha $digest" ] || exit 64
case "$digest" in
  ''|*[!a-f0-9]*) exit 64 ;;
esac
[ "${#digest}" -eq 64 ] || exit 64
exec /usr/bin/sudo -n /usr/local/libexec/eqb-deploy-controller-v1 \
  -- "$command_name" "$transaction" "$sha" "$digest"
