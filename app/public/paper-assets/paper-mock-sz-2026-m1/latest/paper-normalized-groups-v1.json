                  "start": 96,
                  "end": 102
                }
              },
              {
                "type": "text",
                "text": " the author’s words flow like gentle music. The Tang poems, ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[0].text",
                  "start": 102,
                  "end": 162
                }
              },
              {
                "type": "blank",
