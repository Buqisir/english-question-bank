      "semanticDigest": "c374f9885843c05f0567ec613a0f1f6bb5f65c96c078b2312d046534d5e4d273",
      "canonicalGroup": {
        "schemaVersion": "canonical-paper-group-v1",
        "groupId": "group-mock-sz-2026-m1-cloze",
        "groupType": "cloze",
        "title": "完形填空",
        "paragraphs": [
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-title",
            "nodes": [
              {
                "type": "text",
                "text": "I still remember the day I bought my “nice” notebook. It was a leather-bound journal with cream-colored pages. I was sure it would make me the type of person who journals regularly, and who ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[0].text",
                  "start": 0,
                  "end": 190
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-041",
                "blankId": "blank-mock-sz-2026-m1-041",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[0].text",
                  "start": 190,
                  "end": 196
                }
              },
              {
                "type": "text",
                "text": " beautiful thoughts. But it didn’t work.",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[0].text",
                  "start": 196,
                  "end": 236
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[0].text",
              "start": 0,
              "end": 236
            }
          },
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-p1",
            "nodes": [
              {
                "type": "text",
                "text": "That gorgeous notebook sat ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 0,
                  "end": 27
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-042",
                "blankId": "blank-mock-sz-2026-m1-042",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 27,
                  "end": 33
                }
              },
              {
                "type": "text",
                "text": " for months. When I finally opened it, I hesitated. The pages felt too delicate and too ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 33,
                  "end": 121
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-043",
                "blankId": "blank-mock-sz-2026-m1-043",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 121,
                  "end": 127
                }
              },
              {
                "type": "text",
                "text": " to waste on my messy handwriting and ideas. So I ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 127,
                  "end": 177
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-044",
                "blankId": "blank-mock-sz-2026-m1-044",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 177,
                  "end": 183
                }
              },
              {
                "type": "text",
                "text": " it. Instead, I grabbed an old, ugly composition notebook with a ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 183,
                  "end": 248
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-045",
                "blankId": "blank-mock-sz-2026-m1-045",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 248,
                  "end": 254
                }
              },
              {
                "type": "text",
                "text": " cover and dog-eared corners. I started to ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 254,
                  "end": 297
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-046",
                "blankId": "blank-mock-sz-2026-m1-046",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 297,
                  "end": 303
                }
              },
              {
                "type": "text",
                "text": " it with everything: morning pages, random thoughts and reminders. This is surprisingly ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 303,
                  "end": 391
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-047",
                "blankId": "blank-mock-sz-2026-m1-047",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 391,
                  "end": 397
                }
              },
              {
                "type": "text",
                "text": ". I actually wrote. Every day. Without exception.",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 397,
                  "end": 446
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[1].text",
              "start": 0,
              "end": 446
            }
          },
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-p2",
            "nodes": [
              {
                "type": "text",
                "text": "The psychology is real. When we ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 0,
                  "end": 32
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-048",
                "blankId": "blank-mock-sz-2026-m1-048",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 32,
                  "end": 38
                }
              },
              {
                "type": "text",
                "text": " something too much, we place limits around it, feeling it is “too good.” But the ugly notebook carries no such ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 38,
                  "end": 150
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-049",
                "blankId": "blank-mock-sz-2026-m1-049",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 150,
                  "end": 156
                }
              },
              {
                "type": "text",
                "text": ". It has been used. It tells me, “This is a ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 156,
                  "end": 200
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-050",
                "blankId": "blank-mock-sz-2026-m1-050",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 200,
                  "end": 206
                }
              },
              {
                "type": "text",
                "text": " for thinking and living, not a museum piece.”",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[2].text",
                  "start": 206,
                  "end": 252
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[2].text",
              "start": 0,
              "end": 252
            }
          },
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-p3",
            "nodes": [
              {
                "type": "text",
                "text": "Here’s the thing: ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 0,
                  "end": 18
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-051",
                "blankId": "blank-mock-sz-2026-m1-051",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 18,
                  "end": 24
                }
              },
              {
                "type": "text",
                "text": " notebooks are idea incubators ( 孵 化 器 ) . With the pressure off, you experiment more. You try things that might ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 24,
                  "end": 137
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-052",
                "blankId": "blank-mock-sz-2026-m1-052",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 137,
                  "end": 143
                }
              },
              {
                "type": "text",
                "text": ". And in that freedom, bad ideas I was ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 143,
                  "end": 182
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-053",
                "blankId": "blank-mock-sz-2026-m1-053",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 182,
                  "end": 188
                }
              },
              {
                "type": "text",
                "text": " embarrassed about gradually evolved into work I’m proud of. And that’s where the real work of creation happens.",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[3].text",
                  "start": 188,
                  "end": 300
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[3].text",
              "start": 0,
              "end": 300
            }
          },
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-p4",
            "nodes": [
              {
                "type": "text",
                "text": "The best notebook is never the most beautiful one. It’s the one you’ll actually ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[4].text",
                  "start": 0,
                  "end": 80
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-054",
                "blankId": "blank-mock-sz-2026-m1-054",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[4].text",
                  "start": 80,
                  "end": 86
                }
              },
              {
                "type": "text",
                "text": ". Because the magic happens in the ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[4].text",
                  "start": 86,
                  "end": 121
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-055",
                "blankId": "blank-mock-sz-2026-m1-055",
                "hint": null,
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[4].text",
                  "start": 121,
                  "end": 127
                }
              },
              {
                "type": "text",
                "text": ", not in perfect pages.",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[4].text",
                  "start": 127,
                  "end": 150
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[4].text",
              "start": 0,
              "end": 150
            }
          },
          {
            "paragraphId": "para-mock-sz-2026-m1-cloze-p5",
            "nodes": [
              {
                "type": "text",
                "text": "Your ugly notebook is waiting.",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[5].text",
                  "start": 0,
                  "end": 30
                }
              }
            ],
            "sourceSpan": {
              "sourcePath": "group.passage.paragraphs[5].text",
              "start": 0,
              "end": 30
            }
          }
