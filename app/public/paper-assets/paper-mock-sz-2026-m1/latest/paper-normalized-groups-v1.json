            "nodes": [
              {
                "type": "text",
                "text": "When I first opened Where the Deer Hide in the Woods, I felt as if I were stepping into a world ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[0].text",
                  "start": 0,
                  "end": 96
                }
              },
              {
                "type": "blank",
                "questionId": "q-mock-sz-2026-m1-056",
