            "nodes": [
              {
                "type": "text",
                "text": "Before moving to Chongqing, the biggest city Hammond had ever experienced was London. To him, Chongqing was London on a ",
                "sourceSpan": {
                  "sourcePath": "group.passage.paragraphs[1].text",
                  "start": 0,
                  "end": 120
                }
              },
