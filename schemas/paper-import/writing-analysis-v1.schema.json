{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writing-analysis-v1.schema.json",
  "title": "Writing Analysis V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "paperId", "groups"],
  "properties": {
    "schemaVersion": { "const": "writing-analysis-v1" },
    "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "meta": { "type": "object" },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["writing"],
        "properties": {
          "writing": {
            "type": "object",
            "required": ["taskType", "modelAnswer", "highlightExpressions"],
            "additionalProperties": true,
            "properties": {
              "taskType": { "enum": ["application", "continuation"] },
              "modelAnswer": { "type": "string", "minLength": 1 },
              "highlightExpressions": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["text", "note"],
                  "additionalProperties": true,
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "note": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "continuationDesign": {
                "type": "object",
                "required": ["theme", "paragraphs"],
                "additionalProperties": true,
                "properties": {
                  "theme": { "type": "string", "minLength": 1 },
                  "paragraphs": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "reviewCard": {
                "type": "object",
                "required": ["genre", "readerWant", "readerChecklist", "tense", "points", "value"],
                "additionalProperties": true,
                "properties": {
                  "genre": { "type": "string", "minLength": 1 },
                  "readerWant": { "type": "string", "minLength": 1 },
                  "readerChecklist": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "tense": { "type": "string", "minLength": 1 },
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "value": { "type": "string", "minLength": 1 }
                }
              },
              "reviewMarks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["grid", "text", "note"],
                  "additionalProperties": true,
                  "properties": {
                    "grid": {
                      "enum": ["genre", "readerWant", "tense", "points", "readerChecklist"]
                    },
                    "text": { "type": "string", "minLength": 1 },
                    "note": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "if": {
              "properties": { "taskType": { "const": "continuation" } },
              "required": ["taskType"]
            },
            "then": {
              "required": ["continuationDesign"]
            }
          }
        }
      }
    }
  }
}
