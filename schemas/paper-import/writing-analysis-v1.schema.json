{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writing-analysis-v1.schema.json",
  "title": "Writing Analysis V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "paperId", "groups"],
  "properties": {
    "schemaVersion": { "const": "writing-analysis-v1" },
    "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "meta": { "type": "object" },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["writing"],
        "properties": {
          "writing": {
            "type": "object",
            "required": ["taskType", "modelAnswer"],
            "additionalProperties": true,
            "properties": {
              "taskType": { "enum": ["application", "continuation"] },
              "modelAnswer": { "type": "string", "minLength": 1 },
              "officialModelAnswer": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
              },
              "reviewCard": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "form",
                  "topic",
                  "reader",
                  "person",
                  "tense",
                  "type",
                  "points",
                  "readerWho",
                  "readerCares",
                  "readerWants",
                  "value"
                ],
                "properties": {
                  "form": { "$ref": "#/$defs/reviewCardText" },
                  "topic": { "$ref": "#/$defs/reviewCardText" },
                  "reader": { "$ref": "#/$defs/reviewCardText" },
                  "person": { "$ref": "#/$defs/reviewCardText" },
                  "tense": { "$ref": "#/$defs/reviewCardText" },
                  "type": { "$ref": "#/$defs/reviewCardText" },
                  "points": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "$ref": "#/$defs/reviewCardText" }
                  },
                  "readerWho": { "$ref": "#/$defs/reviewCardText" },
                  "readerCares": { "$ref": "#/$defs/reviewCardText" },
                  "readerWants": { "$ref": "#/$defs/reviewCardText" },
                  "value": { "$ref": "#/$defs/reviewCardText" }
                }
              },
              "highlightExpressions": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["text", "note"],
                  "additionalProperties": true,
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "note": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "continuationDesign": {
                "type": "object",
                "required": ["theme", "paragraphs"],
                "additionalProperties": true,
                "properties": {
                  "theme": { "type": "string", "minLength": 1 },
                  "paragraphs": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "oneOf": [
              {
                "properties": { "taskType": { "const": "application" } },
                "required": ["taskType"],
                "not": { "required": ["continuationDesign"] }
              },
              {
                "properties": { "taskType": { "const": "continuation" } },
                "required": [
                  "taskType",
                  "continuationDesign",
                  "highlightExpressions"
                ],
                "not": {
                  "anyOf": [
                    { "required": ["reviewCard"] },
                    { "required": ["officialModelAnswer"] }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "reviewCardText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\r\\n\\u0085\\u000B\\u000C\\u2028\\u2029<>*_`~#\\[\\]])(?![-+*]\\s)(?!\\d+[.)]\\s)(?!-{3,}$).+$"
    }
  }
}
