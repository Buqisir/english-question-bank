{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "writing-analysis-v1.schema.json",
  "title": "Writing Analysis V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "paperId", "groups"],
  "properties": {
    "schemaVersion": { "const": "writing-analysis-v1" },
    "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "meta": { "type": "object" },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["writing"],
        "properties": {
          "writing": {
            "type": "object",
            "required": ["taskType", "modelAnswer"],
            "additionalProperties": true,
            "properties": {
              "taskType": { "enum": ["application", "continuation"] },
              "modelAnswer": { "type": "string", "minLength": 1 },
              "officialModelAnswer": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
              },
              "reviewCard": {
                "oneOf": [
                  { "$ref": "#/$defs/applicationReviewCardV2" },
                  { "$ref": "#/$defs/legacyApplicationReviewCard" }
                ]
              },
              "highlightExpressions": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["text", "note"],
                  "additionalProperties": true,
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "note": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "continuationDesign": {
                "type": "object",
                "required": ["theme", "paragraphs"],
                "additionalProperties": true,
                "properties": {
                  "theme": { "type": "string", "minLength": 1 },
                  "paragraphs": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "continuationAnalysis": {
                "type": "object",
                "additionalProperties": true,
                "required": ["schemaVersion", "storyUnderstanding", "continuationContract"],
                "properties": {
                  "schemaVersion": { "enum": ["continuation-analysis-v1", "continuation-analysis-v2"] }
                },
                "oneOf": [
                  {
                    "properties": { "schemaVersion": { "const": "continuation-analysis-v1" } },
                    "required": ["narrativeDevelopment", "languageAlignment", "paragraphBlueprint"]
                  },
                  {
                    "properties": { "schemaVersion": { "const": "continuation-analysis-v2" } },
                    "required": ["developmentPlan"]
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": { "taskType": { "const": "application" } },
                "required": ["taskType"],
                "allOf": [
                  {
                    "not": {
                      "anyOf": [
                        { "required": ["continuationDesign"] },
                        { "required": ["continuationAnalysis"] }
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "reviewCard": {
                          "properties": {
                            "schemaVersion": { "const": "application-review-card-v2" }
                          },
                          "required": ["schemaVersion"]
                        }
                      },
                      "required": ["reviewCard"]
                    },
                    "then": { "not": { "required": ["highlightExpressions"] } }
                  }
                ]
              },
              {
                "properties": { "taskType": { "const": "continuation" } },
                "not": {
                  "required": ["reviewCard"]
                },
                "oneOf": [
                  {
                    "required": ["continuationAnalysis"],
                    "not": {
                      "anyOf": [
                        { "required": ["continuationDesign"] },
                        { "required": ["highlightExpressions"] }
                      ]
                    }
                  },
                  {
                    "required": ["continuationDesign", "highlightExpressions"],
                    "not": { "required": ["continuationAnalysis"] }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "applicationReviewCardV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "form",
        "topic",
        "purpose",
        "person",
        "tense",
        "points",
        "reader",
        "relationship",
        "readerNeeds",
        "value"
      ],
      "properties": {
        "schemaVersion": { "const": "application-review-card-v2" },
        "form": { "$ref": "#/$defs/reviewCardText" },
        "topic": { "$ref": "#/$defs/reviewCardText" },
        "purpose": { "$ref": "#/$defs/reviewCardText" },
        "person": { "$ref": "#/$defs/reviewCardText" },
        "tense": { "$ref": "#/$defs/reviewCardText" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reviewCardText" }
        },
        "reader": { "$ref": "#/$defs/reviewCardText" },
        "relationship": { "$ref": "#/$defs/reviewCardText" },
        "readerNeeds": { "$ref": "#/$defs/reviewCardText" },
        "value": { "$ref": "#/$defs/reviewCardText" }
      }
    },
    "legacyApplicationReviewCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "topic",
        "reader",
        "person",
        "tense",
        "type",
        "points",
        "readerWho",
        "readerCares",
        "readerWants",
        "value"
      ],
      "properties": {
        "form": { "$ref": "#/$defs/reviewCardText" },
        "topic": { "$ref": "#/$defs/reviewCardText" },
        "reader": { "$ref": "#/$defs/reviewCardText" },
        "person": { "$ref": "#/$defs/reviewCardText" },
        "tense": { "$ref": "#/$defs/reviewCardText" },
        "type": { "$ref": "#/$defs/reviewCardText" },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/reviewCardText" }
        },
        "readerWho": { "$ref": "#/$defs/reviewCardText" },
        "readerCares": { "$ref": "#/$defs/reviewCardText" },
        "readerWants": { "$ref": "#/$defs/reviewCardText" },
        "value": { "$ref": "#/$defs/reviewCardText" }
      }
    },
    "reviewCardText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\r\\n\\u0085\\u000B\\u000C\\u2028\\u2029<>*_`~#\\[\\]])(?![-+*]\\s)(?!\\d+[.)]\\s)(?!-{3,}$).+$"
    }
  }
}
