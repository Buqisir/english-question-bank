{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format2-transcription-v1.schema.json",
  "title": "Format 2 per-paper transcription v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paperId",
    "format",
    "provenance",
    "sourceBindings",
    "answerTranscriptionCheck",
    "groups",
    "officialAnswers",
    "visuals"
  ],
  "properties": {
    "schemaVersion": { "const": "format2-transcription-v1" },
    "paperId": { "$ref": "#/$defs/paperId" },
    "format": { "const": "format2-pdf-pair-v1" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionPdfSha256", "answerPdfSha256"],
      "properties": {
        "questionPdfSha256": { "$ref": "#/$defs/sha256" },
        "answerPdfSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "answerTranscriptionCheck": {
      "oneOf": [
        { "$ref": "#/$defs/answerTextCheck" },
        { "$ref": "#/$defs/answerImageCheck" }
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "officialAnswers": {
      "type": "array",
      "items": { "$ref": "#/$defs/officialAnswer" }
    },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visual" }
    }
  },
  "$defs": {
    "paperId": {
      "type": "string",
      "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "questionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "byteSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "pixelBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "answerMarkingCommon": {
      "type": "object",
      "properties": {
        "questionId": { "$ref": "#/$defs/nonEmpty" },
        "questionNo": { "type": "integer", "minimum": 1 },
        "questionRange": { "$ref": "#/$defs/questionRange" },
        "answerOrdinal": { "type": "integer", "minimum": 0 },
        "answer": { "$ref": "#/$defs/nonEmpty" },
        "page": { "type": "integer", "minimum": 1 },
        "sourceMarking": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "answerTextMarking": {
      "allOf": [
        { "$ref": "#/$defs/answerMarkingCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "questionId", "questionNo", "questionRange", "answerOrdinal",
            "answer", "page", "sourceMarking", "byteSpan", "answerByteSpan"
          ],
          "properties": {
            "questionId": { "$ref": "#/$defs/nonEmpty" },
            "questionNo": { "type": "integer", "minimum": 1 },
            "questionRange": { "$ref": "#/$defs/questionRange" },
            "answerOrdinal": { "type": "integer", "minimum": 0 },
            "answer": { "$ref": "#/$defs/nonEmpty" },
            "page": { "type": "integer", "minimum": 1 },
            "sourceMarking": { "$ref": "#/$defs/nonEmpty" },
            "byteSpan": { "$ref": "#/$defs/byteSpan" },
            "answerByteSpan": { "$ref": "#/$defs/byteSpan" }
          }
        }
      ]
    },
    "answerImageMarking": {
      "allOf": [
        { "$ref": "#/$defs/answerMarkingCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "questionId", "questionNo", "questionRange", "answerOrdinal",
            "answer", "page", "sourceMarking", "regionId"
          ],
          "properties": {
            "questionId": { "$ref": "#/$defs/nonEmpty" },
            "questionNo": { "type": "integer", "minimum": 1 },
            "questionRange": { "$ref": "#/$defs/questionRange" },
            "answerOrdinal": { "type": "integer", "minimum": 0 },
            "answer": { "$ref": "#/$defs/nonEmpty" },
            "page": { "type": "integer", "minimum": 1 },
            "sourceMarking": { "$ref": "#/$defs/nonEmpty" },
            "regionId": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "answerCheckBaseProperties": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "answer-transcription-check-v2" },
        "method": { "const": "ai-source-markings-vs-answer-key" },
        "answerPdfSha256": { "$ref": "#/$defs/sha256" },
        "officialAnswersDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "answerTextCheck": {
      "allOf": [
        { "$ref": "#/$defs/answerCheckBaseProperties" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion", "method", "answerPdfSha256",
            "officialAnswersDigest", "evidenceKind", "extraction", "sourceMarkings"
          ],
          "properties": {
            "schemaVersion": { "const": "answer-transcription-check-v2" },
            "method": { "const": "ai-source-markings-vs-answer-key" },
            "answerPdfSha256": { "$ref": "#/$defs/sha256" },
            "officialAnswersDigest": { "$ref": "#/$defs/sha256" },
            "evidenceKind": { "const": "text" },
            "extraction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion", "tool", "toolVersion", "parameters",
                "extractedText", "extractedTextSha256"
              ],
              "properties": {
                "schemaVersion": { "const": "answer-text-extraction-v1" },
                "tool": { "const": "pdftotext" },
                "toolVersion": { "$ref": "#/$defs/nonEmpty" },
                "parameters": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/nonEmpty" }
                },
                "extractedText": { "$ref": "#/$defs/nonEmpty" },
                "extractedTextSha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "sourceMarkings": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/answerTextMarking" }
            }
          }
        }
      ]
    },
    "answerImageCheck": {
      "allOf": [
        { "$ref": "#/$defs/answerCheckBaseProperties" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion", "method", "answerPdfSha256", "officialAnswersDigest",
            "evidenceKind", "rasterization", "pages", "regions", "sourceMarkings"
          ],
          "properties": {
            "schemaVersion": { "const": "answer-transcription-check-v2" },
            "method": { "const": "ai-source-markings-vs-answer-key" },
            "answerPdfSha256": { "$ref": "#/$defs/sha256" },
            "officialAnswersDigest": { "$ref": "#/$defs/sha256" },
            "evidenceKind": { "const": "page_image_regions" },
            "rasterization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "tool", "toolVersion", "parameters", "dpi"],
              "properties": {
                "schemaVersion": { "const": "answer-page-rasterization-v1" },
                "tool": { "const": "pdftoppm" },
                "toolVersion": { "$ref": "#/$defs/nonEmpty" },
                "parameters": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/nonEmpty" }
                },
                "dpi": { "type": "integer", "minimum": 36, "maximum": 600 }
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page", "pixelWidth", "pixelHeight", "sha256", "byteLength"],
                "properties": {
                  "page": { "type": "integer", "minimum": 1 },
                  "pixelWidth": { "type": "integer", "minimum": 1 },
                  "pixelHeight": { "type": "integer", "minimum": 1 },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "byteLength": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["regionId", "page", "pixelBox", "sha256", "byteLength"],
                "properties": {
                  "regionId": { "$ref": "#/$defs/nonEmpty" },
                  "page": { "type": "integer", "minimum": 1 },
                  "pixelBox": { "$ref": "#/$defs/pixelBox" },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "byteLength": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "sourceMarkings": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/answerImageMarking" }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paperName", "sourceLabel"],
      "properties": {
        "paperName": { "$ref": "#/$defs/nonEmpty" },
        "sourceLabel": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mimeType",
        "encodedBytes",
        "byteLength",
        "sha256",
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "mimeType": { "const": "image/png" },
        "encodedBytes": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pixelWidth": { "type": "integer", "minimum": 1 },
        "pixelHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship", "sourceTruth"],
        "properties": {
          "relationship": { "$ref": "#/$defs/nonEmpty" },
          "sourceTruth": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "editableVector": { "$ref": "#/$defs/nonEmpty" },
        "prompt": { "$ref": "#/$defs/nonEmpty" },
        "tool": { "$ref": "#/$defs/nonEmpty" },
        "model": { "$ref": "#/$defs/nonEmpty" },
        "exportSettings": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groupId"],
          "properties": {
            "kind": { "const": "passage" },
            "groupId": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "groupId", "questionId", "optionId"],
          "properties": {
            "kind": { "const": "reading_option" },
            "groupId": { "$ref": "#/$defs/nonEmpty" },
            "questionId": { "$ref": "#/$defs/nonEmpty" },
            "optionId": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "pointBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "pointSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "visualSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentRole",
        "page",
        "pageSizePoints",
        "pointGeometry",
        "extraction"
      ],
      "properties": {
        "documentRole": { "const": "question_pdf" },
        "page": { "type": "integer", "minimum": 1 },
        "pageSizePoints": { "$ref": "#/$defs/pointSize" },
        "pointGeometry": { "$ref": "#/$defs/pointBox" },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "extractor", "version"],
          "properties": {
            "kind": { "enum": ["embedded_image", "page_region_crop"] },
            "objectId": { "$ref": "#/$defs/nonEmpty" },
            "extractor": { "$ref": "#/$defs/nonEmpty" },
            "version": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "trigger",
        "artifact",
        "sourceTruthChecklist",
        "reproducibility"
      ],
      "properties": {
        "method": { "enum": ["vector_authored", "reference_restored"] },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": { "enum": ["legibility_problem", "owner_request"] },
            "note": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "artifact": { "$ref": "#/$defs/artifact" },
        "sourceTruthChecklist": { "$ref": "#/$defs/checklist" },
        "reproducibility": { "$ref": "#/$defs/reproducibility" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "owner",
        "source",
        "targetSizePoints",
        "sourceCrop",
        "sourceTruthChecklist",
        "alternatives"
      ],
      "properties": {
        "observationId": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/owner" },
        "source": { "$ref": "#/$defs/visualSource" },
        "targetSizePoints": { "$ref": "#/$defs/pointSize" },
        "sourceCrop": { "$ref": "#/$defs/artifact" },
        "sourceTruthChecklist": { "$ref": "#/$defs/checklist" },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" }
        }
      }
    },
    "option": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionId", "label", "contentKind", "text"],
          "properties": {
            "optionId": { "$ref": "#/$defs/nonEmpty" },
            "label": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
            "contentKind": { "const": "text" },
            "text": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionId", "label", "contentKind", "visualObservationId"],
          "properties": {
            "optionId": { "$ref": "#/$defs/nonEmpty" },
            "label": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
            "contentKind": { "const": "figure" },
            "visualObservationId": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "questionNo", "stem", "options", "answerRef"],
      "properties": {
        "questionId": { "$ref": "#/$defs/nonEmpty" },
        "questionNo": { "type": "integer", "minimum": 1 },
        "stem": { "$ref": "#/$defs/nonEmpty" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "answerRef": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "text"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "text" },
        "text": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "rows"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "table" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "framedColumnsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "columns"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "framed_columns" },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columnId", "paragraphs"],
            "properties": {
              "columnId": { "$ref": "#/$defs/nonEmpty" },
              "heading": { "$ref": "#/$defs/nonEmpty" },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          }
        }
      }
    },
    "visualPlaceholderBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "visualObservationId"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "visual_placeholder" },
        "visualObservationId": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "listeningBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "questions", "answers", "transcript", "inventory"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "listening_material" },
        "questions": { "type": "object" },
        "answers": { "type": "object" },
        "transcript": { "type": "object" },
        "inventory": { "type": "object" }
      }
    },
    "writingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "taskType", "prompt", "wordCountTarget"],
      "properties": {
        "blockId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "const": "writing_material" },
        "taskType": { "enum": ["application", "continuation"] },
        "prompt": { "$ref": "#/$defs/nonEmpty" },
        "wordCountTarget": { "type": "integer", "minimum": 1 },
        "wordCountScope": { "enum": ["student_authored_only", "unspecified"] },
        "sourceInstruction": { "$ref": "#/$defs/nonEmpty" },
        "applicationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writerRole",
            "audienceOrDestination",
            "deliverable",
            "communicativePurpose",
            "contentRequirements",
            "answerRegionAbsent"
          ],
          "properties": {
            "writerRole": { "$ref": "#/$defs/nonEmpty" },
            "audienceOrDestination": { "$ref": "#/$defs/nonEmpty" },
            "deliverable": { "$ref": "#/$defs/nonEmpty" },
            "communicativePurpose": { "$ref": "#/$defs/nonEmpty" },
            "contentRequirements": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmpty" }
            },
            "answerRegionAbsent": { "const": true }
          }
        },
        "continuationStarters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/framedColumnsBlock" },
        { "$ref": "#/$defs/visualPlaceholderBlock" },
        { "$ref": "#/$defs/listeningBlock" },
        { "$ref": "#/$defs/writingBlock" }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "slotId", "groupType", "blocks", "questions"],
      "properties": {
        "groupId": { "$ref": "#/$defs/nonEmpty" },
        "slotId": {
          "enum": [
            "reading.a",
            "reading.b",
            "reading.c",
            "reading.d",
            "reading.seven-choices",
            "language.cloze",
            "language.grammar-fill",
            "writing.application",
            "writing.continuation",
            "listening.raw"
          ]
        },
        "groupType": {
          "enum": [
            "reading",
            "seven_choices",
            "cloze",
            "grammar_fill",
            "listening",
            "application_writing",
            "continuation_writing"
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "officialAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerRef", "questionId", "answer", "source"],
      "properties": {
        "answerRef": { "$ref": "#/$defs/nonEmpty" },
        "questionId": { "$ref": "#/$defs/nonEmpty" },
        "answer": { "$ref": "#/$defs/nonEmpty" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentRole", "page"],
          "properties": {
            "documentRole": { "const": "answer_pdf" },
            "page": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
