{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format2-transcription-v3.schema.json",
  "title": "Format 2 source-faithful transcription v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paperId",
    "format",
    "provenance",
    "sourceBindings",
    "sourceRegions",
    "answerTranscriptionCheck",
    "listeningSource",
    "analysisSidecars",
    "groups",
    "officialAnswers",
    "visuals"
  ],
  "properties": {
    "schemaVersion": { "const": "format2-transcription-v3" },
    "paperId": { "$ref": "format2-transcription-v1.schema.json#/$defs/paperId" },
    "format": { "const": "format2-pdf-pair-v1" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sourceBindings": { "$ref": "#/$defs/sourceBindings" },
    "sourceRegions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRegion" }
    },
    "answerTranscriptionCheck": {
      "oneOf": [
        { "$ref": "format2-transcription-v1.schema.json#/$defs/answerTextCheck" },
        { "$ref": "format2-transcription-v1.schema.json#/$defs/answerImageCheck" }
      ]
    },
    "listeningSource": { "$ref": "format2-transcription-v2.schema.json#/$defs/listeningSource" },
    "analysisSidecars": {
      "type": "array",
      "items": { "$ref": "format2-transcription-v2.schema.json#/$defs/analysisSidecar" }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "officialAnswers": {
      "type": "array",
      "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/officialAnswer" }
    },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visual" }
    },
    "sourceMeasuredFigureLayouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/sourceMeasuredFigureLayout" }
    }
  },
  "$defs": {
    "sourceRegionRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
    },
    "normalizedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sourceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRegionId", "documentRole", "page", "region"],
      "properties": {
        "sourceRegionId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "documentRole": { "const": "question_pdf" },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/normalizedRegion" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "paperName",
        "sourceLabel",
        "year",
        "region",
        "examCode",
        "subject",
        "sourceType",
        "defaultTags",
        "questionSource"
      ],
      "properties": {
        "schemaVersion": { "const": "format2-provenance-v2" },
        "paperName": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceLabel": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "year": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "examCode": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "subject": { "const": "English" },
        "sourceType": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "defaultTags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
        },
        "questionSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentRole", "originalName", "sha256"],
          "properties": {
            "documentRole": { "const": "question_pdf" },
            "originalName": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
            "sha256": { "$ref": "format2-transcription-v1.schema.json#/$defs/sha256" }
          }
        }
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionPdfSha256", "answerPdfSha256"],
      "properties": {
        "questionPdfSha256": { "$ref": "format2-transcription-v1.schema.json#/$defs/sha256" },
        "answerPdfSha256": { "$ref": "format2-transcription-v1.schema.json#/$defs/sha256" }
      }
    },
    "sourceNumbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["printedOrdinal", "sourceRegionRefs"],
      "properties": {
        "printedOrdinal": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "promptProvision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provision", "prompt", "sourceContentRef", "sourceRegionRefs"],
          "properties": {
            "provision": { "const": "source_prompt" },
            "prompt": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
            "sourceContentRef": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
            "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provision", "sourceRegionRefs"],
          "properties": {
            "provision": { "const": "source_proven_none" },
            "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
          }
        }
      ]
    },
    "textOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label", "contentKind", "text", "sourceRegionRefs"],
      "properties": {
        "optionId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "label": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
        "contentKind": { "const": "text" },
        "text": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "figureOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label", "contentKind", "visualObservationId"],
      "properties": {
        "optionId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "label": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
        "contentKind": { "const": "figure" },
        "visualObservationId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "questionNo",
        "stem",
        "options",
        "answerRef",
        "sourceRegionRefs",
        "sourceNumbering"
      ],
      "properties": {
        "questionId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "questionNo": { "type": "integer", "minimum": 1 },
        "stem": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "options": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/textOption" },
              { "$ref": "#/$defs/figureOption" }
            ]
          }
        },
        "answerRef": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "promptProvision": { "$ref": "#/$defs/promptProvision" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" },
        "sourceNumbering": { "$ref": "#/$defs/sourceNumbering" }
      }
    },
    "objectiveTextInline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contentId", "text", "sourceRegionRefs"],
      "properties": {
        "kind": { "const": "text" },
        "contentId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "text": { "type": "string" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "objectiveBlankInline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contentId", "questionId", "sourceRegionRefs"],
      "properties": {
        "kind": { "const": "blank_ref" },
        "contentId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "questionId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "objectiveParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "sourceRegionRefs", "inlines"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "objective_paragraph" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" },
        "inlines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/objectiveTextInline" },
              { "$ref": "#/$defs/objectiveBlankInline" }
            ]
          }
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "text", "sourceRegionRefs"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "text" },
        "text": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "rows", "sourceRegionRefs"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "table" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "framedColumnsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "columns", "sourceRegionRefs"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "framed_columns" },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columnId", "paragraphs"],
            "properties": {
              "columnId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
              "heading": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
              }
            }
          }
        },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "visualPlaceholderBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "visualObservationId", "sourceRegionRefs"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "visual_placeholder" },
        "visualObservationId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "exactDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "originalName", "byteLength", "sha256", "encodedBytes"],
      "properties": {
        "mediaType": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "originalName": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "format2-transcription-v1.schema.json#/$defs/sha256" },
        "encodedBytes": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
      }
    },
    "listeningBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "kind", "questions", "answers", "transcript", "inventory"],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "listening_material" },
        "questions": { "$ref": "#/$defs/exactDocument" },
        "answers": { "$ref": "#/$defs/exactDocument" },
        "transcript": { "$ref": "#/$defs/exactDocument" },
        "inventory": { "$ref": "#/$defs/exactDocument" }
      }
    },
    "applicationGiven": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provision", "sourceRegionRefs"],
          "properties": {
            "provision": { "const": "source_proven_none" },
            "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provision", "sourceRegionRefs", "parts"],
          "properties": {
            "provision": { "const": "source_provided" },
            "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["partId", "blockId", "role", "text", "sourceRegionRefs"],
                "properties": {
                  "partId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
                  "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
                  "role": { "enum": ["title", "salutation", "opening", "closing", "signature"] },
                  "text": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
                  "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
                }
              }
            }
          }
        }
      ]
    },
    "applicationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writerRole", "audienceOrDestination", "deliverable",
        "communicativePurpose", "contentRequirements", "answerRegionAbsent",
        "sourceRegionRefs"
      ],
      "properties": {
        "writerRole": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "audienceOrDestination": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "deliverable": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "communicativePurpose": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "contentRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
        },
        "answerRegionAbsent": { "type": "boolean" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      }
    },
    "writingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId", "kind", "taskType", "prompt", "wordCountTarget",
        "wordCountScope", "sourceRegionRefs"
      ],
      "properties": {
        "blockId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "kind": { "const": "writing_material" },
        "taskType": { "enum": ["application", "continuation"] },
        "prompt": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "wordCountTarget": { "type": "integer", "minimum": 1 },
        "wordCountScope": { "enum": ["student_authored_only", "unspecified"] },
        "sourceInstruction": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "applicationEvidence": { "$ref": "#/$defs/applicationEvidence" },
        "applicationGiven": { "$ref": "#/$defs/applicationGiven" },
        "continuationStarters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" }
        },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" }
      },
      "allOf": [
        {
          "if": { "properties": { "taskType": { "const": "application" } } },
          "then": { "required": ["applicationEvidence", "applicationGiven"] }
        },
        {
          "if": { "properties": { "taskType": { "const": "continuation" } } },
          "then": { "required": ["sourceInstruction", "continuationStarters"] }
        }
      ]
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/framedColumnsBlock" },
        { "$ref": "#/$defs/visualPlaceholderBlock" },
        { "$ref": "#/$defs/objectiveParagraph" },
        { "$ref": "#/$defs/listeningBlock" },
        { "$ref": "#/$defs/writingBlock" }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "slotId", "groupType", "blocks", "questions"],
      "properties": {
        "groupId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "slotId": { "$ref": "format2-transcription-v1.schema.json#/$defs/group/properties/slotId" },
        "groupType": { "$ref": "format2-transcription-v1.schema.json#/$defs/group/properties/groupType" },
        "sourceRegionRefs": { "$ref": "#/$defs/sourceRegionRefs" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/question" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "groupType": { "not": { "const": "listening" } } },
            "required": ["groupType"]
          },
          "then": { "required": ["sourceRegionRefs"] }
        }
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "owner",
        "source",
        "targetSizePoints",
        "sourceCrop",
        "sourceTruthChecklist",
        "alternatives"
      ],
      "properties": {
        "observationId": { "$ref": "format2-transcription-v1.schema.json#/$defs/nonEmpty" },
        "stableIdentities": {
          "$ref": "format2-transcription-v1.schema.json#/$defs/visual/properties/stableIdentities"
        },
        "owner": { "$ref": "format2-transcription-v1.schema.json#/$defs/owner" },
        "source": { "$ref": "format2-transcription-v1.schema.json#/$defs/visualSource" },
        "targetSizePoints": { "$ref": "format2-transcription-v1.schema.json#/$defs/pointSize" },
        "sourceCrop": { "$ref": "format2-transcription-v1.schema.json#/$defs/artifact" },
        "sourceCropReproducibility": {
          "$ref": "format2-transcription-v1.schema.json#/$defs/reproducibility"
        },
        "sourceTruthChecklist": { "$ref": "format2-transcription-v1.schema.json#/$defs/checklist" },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "format2-transcription-v1.schema.json#/$defs/alternative" }
        }
      }
    }
  }
}
