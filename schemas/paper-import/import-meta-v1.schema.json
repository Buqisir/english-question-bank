{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "import-meta-v1.schema.json",
  "title": "Paper Import Meta V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "paperId", "sourceFileName", "sourceFileSha256", "paper"],
  "properties": {
    "schemaVersion": { "const": "import-meta-v1" },
    "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sourceFileName": { "type": "string", "minLength": 1 },
    "sourceFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "importedBy": { "type": "string" },
    "importedAt": { "type": "string" },
    "paginationPlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "paperId", "sourceAssetVersion", "sourceDigest", "canonicalSourceDigest", "candidateDigest", "planDigest"],
      "properties": {
        "schemaVersion": { "const": "paper-pagination-binding-v1" },
        "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sourceAssetVersion": { "type": "integer", "minimum": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "canonicalSourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "planDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "region", "paperName", "examCode", "subject", "sourceType", "defaultTags"],
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "region": { "type": "string", "minLength": 1 },
        "paperName": { "type": "string", "minLength": 1 },
        "examCode": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "subject": { "type": "string", "minLength": 1 },
        "sourceType": {
          "type": "string",
          "enum": ["真题", "模拟题", "校本题", "自编题"]
        },
        "defaultTags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId"],
        "properties": {
          "groupId": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["低", "中", "高"] },
          "summary": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "topicLabels": { "type": "array", "items": { "type": "string" } },
          "displayTitleOverride": { "type": "string" }
        }
      }
    }
  }
}
