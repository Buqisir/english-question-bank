{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-references-capture-v26",
  "description": "Source-derived bounded alternate answers before listening; content schemas and historical capture bytes remain immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerVersion",
    "paperId",
    "sourceDigest",
    "candidateDigest",
    "materializationDigest",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "source-references-v1",
        "source-references-v2",
        "source-references-v3",
        "source-references-v4",
        "source-references-v5",
        "source-references-v6"
      ]
    },
    "producerVersion": {
      "const": "ocr-source-references-producer-v26"
    },
    "paperId": {
      "$ref": "source-references-v1#/properties/paperId"
    },
    "sourceDigest": {
      "$ref": "source-references-v1#/$defs/digest"
    },
    "candidateDigest": {
      "$ref": "source-references-v1#/$defs/digest"
    },
    "materializationDigest": {
      "$ref": "source-references-v1#/$defs/digest"
    },
    "groups": {
      "type": "array"
    },
    "figureExclusions": {
      "$ref": "source-references-v5#/properties/figureExclusions"
    },
    "wholeDocumentWritingAbsence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceSetDigest",
        "evidenceSha256",
        "confirmationSha256",
        "authorSessionId",
        "review"
      ],
      "properties": {
        "kind": {
          "const": "both_writing_tasks_absent_from_whole_answer_document"
        },
        "sourceSetDigest": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "evidenceSha256": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "confirmationSha256": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "authorSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewedBy",
            "reviewerSessionId",
            "reviewedSubjectDigest",
            "verdict",
            "pages"
          ],
          "properties": {
            "reviewedBy": {
              "const": "import_agent"
            },
            "reviewerSessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "reviewedSubjectDigest": {
              "$ref": "source-references-v1#/$defs/digest"
            },
            "verdict": {
              "const": "confirmed_absent"
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "documentId",
                  "page",
                  "rasterSha256",
                  "finding"
                ],
                "properties": {
                  "documentId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^\\S(?:.*\\S)?$"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rasterSha256": {
                    "$ref": "source-references-v1#/$defs/digest"
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        }
      }
    },
    "alternateAnswerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "documentSha256",
        "evidenceSha256",
        "confirmationSha256",
        "startInclusiveItemId",
        "endExclusiveItemId",
        "followingText1ItemId",
        "orderedItemIds"
      ],
      "properties": {
        "kind": {
          "const": "alternate_answers_before_listening"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "startInclusiveItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "endExclusiveItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "followingText1ItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "documentSha256": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "evidenceSha256": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "confirmationSha256": {
          "$ref": "source-references-v1#/$defs/digest"
        },
        "orderedItemIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v1"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "$ref": "source-references-v1#/properties/groups"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v2"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "$ref": "source-references-v2#/properties/groups"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v3"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "$ref": "source-references-v3#/properties/groups"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v4"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "$ref": "source-references-v4#/properties/groups"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v5"
          }
        }
      },
      "then": {
        "required": [
          "figureExclusions"
        ],
        "properties": {
          "groups": {
            "$ref": "source-references-v5#/properties/groups"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "figureExclusions"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "source-references-v6"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "$ref": "source-references-v6#/properties/groups"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "wholeDocumentWritingAbsence",
          "alternateAnswerScope"
        ]
      }
    }
  ]
}
