{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-references-v7",
  "description": "Unofficial writing supplements. The source projection is additionally validated against its unchanged sourceSchemaVersion and producerVersion.",
  "type": "object",
  "required": ["schemaVersion", "sourceSchemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": "source-references-v7" },
    "sourceSchemaVersion": { "enum": ["source-references-v1", "source-references-v2", "source-references-v3", "source-references-v4", "source-references-v5", "source-references-v6"] },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["essays"],
        "properties": {
          "essays": {
            "type": "object",
            "required": ["entries"],
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "if": { "required": ["provenance"] },
                  "then": { "$ref": "#/$defs/unofficialEssay" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "unofficialEssay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "provenance", "paragraphs"],
      "properties": {
        "referenceId": { "$ref": "source-references-v1#/$defs/id" },
        "provenance": { "const": "unofficial" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraphId", "role", "text"],
            "properties": {
              "paragraphId": { "$ref": "source-references-v1#/$defs/id" },
              "role": { "enum": ["title", "salutation", "body", "closing", "signature"] },
              "text": { "type": "string", "pattern": "\\S" }
            }
          }
        }
      }
    }
  }
}
