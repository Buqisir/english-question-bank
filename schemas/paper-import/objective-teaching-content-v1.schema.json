{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective-teaching-content-v1.schema.json",
  "title": "Objective Teaching Content V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceTextId", "sourceAssetVersion", "translation", "completedSourceTexts", "annotations"],
  "properties": {
    "schemaVersion": { "const": "objective-teaching-content-v1" },
    "sourceTextId": { "$ref": "#/$defs/id" },
    "sourceAssetVersion": { "type": "integer", "minimum": 1 },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textId", "legacyField", "paragraphs"],
      "properties": {
        "textId": { "$ref": "#/$defs/id" },
        "legacyField": { "const": "fullTranslationZh" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/translationParagraph" }
        }
      }
    },
    "completedSourceTexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/completedSourceText" }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/annotation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "baseRange": {
      "type": "object",
      "required": ["start", "end", "quote"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "range": {
      "allOf": [
        { "$ref": "#/$defs/baseRange" },
        {
          "type": "object",
          "required": ["textId", "paragraphId"],
          "properties": {
            "textId": { "$ref": "#/$defs/id" },
            "paragraphId": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "translationParagraph": {
      "allOf": [
        { "$ref": "#/$defs/baseRange" },
        {
          "type": "object",
          "required": ["paragraphId", "sourceParagraphIds"],
          "properties": {
            "paragraphId": { "$ref": "#/$defs/id" },
            "sourceParagraphIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "completedSourceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textId", "paragraphId", "text"],
      "properties": {
        "textId": { "$ref": "#/$defs/id" },
        "paragraphId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["annotationId", "kind", "questionIds", "sourceRanges", "translationRanges"],
      "properties": {
        "annotationId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["answer-evidence", "answer-insertion", "sentence-structure"] },
        "questionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "blankId": { "$ref": "#/$defs/id" },
        "selectedSentenceId": { "$ref": "#/$defs/id" },
        "sourceRanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } },
        "translationRanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["answer-evidence", "answer-insertion"] } } },
          "then": { "properties": { "questionIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "answer-insertion" } } },
          "then": { "required": ["blankId"], "not": { "required": ["selectedSentenceId"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "sentence-structure" } } },
          "then": { "required": ["selectedSentenceId"], "not": { "required": ["blankId"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "answer-evidence" } } },
          "then": { "not": { "anyOf": [{ "required": ["blankId"] }, { "required": ["selectedSentenceId"] }] } }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
