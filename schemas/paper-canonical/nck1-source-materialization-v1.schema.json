{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nck1-source-materialization-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paperId",
    "profileId",
    "documents",
    "groups",
    "answers",
    "media",
    "sourceCoverage",
    "listening",
    "issues"
  ],
  "properties": {
    "schemaVersion": { "const": "nck1-source-materialization-v1" },
    "paperId": { "type": "string", "pattern": "^paper-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profileId": { "const": "nck1" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "groups": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/group" }
    },
    "answers": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": { "$ref": "#/$defs/answer" }
    },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/media" }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "reviewedPages", "visuals"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "reviewedPages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "visuals": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceVisual" }
        }
      }
    },
    "listening": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidence"],
          "properties": {
            "state": { "const": "not_supplied" },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "documentId"],
              "properties": {
                "kind": { "const": "question_source_reviewed_no_listening_content" },
                "documentId": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "questions", "answers", "transcript", "timing"],
          "properties": {
            "state": { "const": "captured" },
            "questions": { "type": "array", "minItems": 20, "maxItems": 20 },
            "answers": { "type": "array", "minItems": 20, "maxItems": 20 },
            "transcript": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["segmentId", "text", "questionNumbers", "source"],
                "properties": {
                  "segmentId": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 },
                  "questionNumbers": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 1, "maximum": 20 }
                  },
                  "source": { "$ref": "#/$defs/locator" }
                }
              }
            },
            "timing": { "type": "array" }
          }
        }
      ]
    },
    "issues": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "documentId", "page", "region"],
          "properties": {
            "kind": { "const": "page_region" },
            "documentId": { "type": "string" },
            "page": { "type": "integer", "minimum": 1 },
            "region": { "$ref": "#/$defs/region" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "documentId", "part", "selector"],
          "properties": {
            "kind": { "const": "docx_part" },
            "documentId": { "type": "string" },
            "part": { "type": "string", "minLength": 1 },
            "selector": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "role", "mediaType", "sha256", "byteLength", "pageCount"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["question_source", "official_answers", "question_and_answers"] },
        "mediaType": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "pageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "paragraphContent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "blankId"],
          "properties": {
            "kind": { "const": "blank_ref" },
            "blankId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "sourceNumber", "canonicalNumber", "stem", "options", "blankId", "prompt", "source"],
      "properties": {
        "questionId": { "type": "string", "minLength": 1 },
        "sourceNumber": { "type": "integer", "minimum": 1 },
        "canonicalNumber": { "type": "integer", "minimum": 21, "maximum": 65 },
        "stem": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "blankId": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/locator" }
      }
    },
    "block": {
      "type": "object",
      "required": ["kind", "blockId", "source"],
      "properties": {
        "kind": { "enum": ["paragraph", "table", "figure", "framed_columns"] },
        "blockId": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/locator" },
        "role": { "enum": ["title", "subtitle", "body"] },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/paragraphContent" }
        }
      }
    },
    "writingTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskType", "prompt", "material", "starters", "givenSkeleton", "wordCountTarget", "officialModelAnswer", "source"],
      "properties": {
        "taskType": { "enum": ["application", "continuation"] },
        "prompt": { "type": "string", "minLength": 1 },
        "material": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "starters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "givenSkeleton": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "role"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "role": { "enum": ["title", "salutation", "opening", "closing", "signature"] }
            }
          }
        },
        "wordCountTarget": { "type": "integer", "minimum": 1 },
        "officialModelAnswer": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/locator" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "groupId", "family", "blocks", "questions", "optionBank", "writingTask"],
      "properties": {
        "slotId": { "type": "string" },
        "groupId": { "type": "string", "minLength": 1 },
        "family": { "type": "string" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "optionBank": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "writingTask": { "oneOf": [{ "$ref": "#/$defs/writingTask" }, { "type": "null" }] }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "canonicalNumber", "value", "authority"],
      "properties": {
        "questionId": { "type": "string", "minLength": 1 },
        "canonicalNumber": { "type": "integer", "minimum": 21, "maximum": 65 },
        "value": { "type": "string", "minLength": 1 },
        "authority": { "$ref": "#/$defs/locator" }
      }
    },
    "sourceVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualId", "page", "disposition", "targetId"],
      "properties": {
        "visualId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/region" },
        "disposition": { "enum": ["semantic_table", "content_media", "furniture"] },
        "targetId": { "type": ["string", "null"] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaId", "usage", "kind", "mimeType", "sha256", "pixelWidth", "pixelHeight", "extraction"],
      "properties": {
        "mediaId": { "type": "string", "minLength": 1 },
        "usage": { "enum": ["content", "visual_proof"] },
        "kind": { "enum": ["figure", "icon", "barcode"] },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "pixelWidth": { "type": "integer", "minimum": 1 },
        "pixelHeight": { "type": "integer", "minimum": 1 },
        "extraction": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "documentId", "entryName"],
              "properties": {
                "kind": { "const": "docx_media" },
                "documentId": { "type": "string", "minLength": 1 },
                "entryName": { "type": "string", "pattern": "^word/media/[^/]+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "documentId", "entryName", "density"],
              "properties": {
                "kind": { "const": "docx_svg_raster" },
                "documentId": { "type": "string", "minLength": 1 },
                "entryName": { "type": "string", "pattern": "^word/media/[^/]+[.]svg$" },
                "density": { "type": "integer", "minimum": 72, "maximum": 600 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "documentId", "page", "region", "density"],
              "properties": {
                "kind": { "const": "pdf_crop" },
                "documentId": { "type": "string", "minLength": 1 },
                "page": { "type": "integer", "minimum": 1 },
                "region": { "$ref": "#/$defs/region" },
                "density": { "type": "integer", "minimum": 72, "maximum": 600 }
              }
            }
          ]
        }
      }
    }
  }
}
