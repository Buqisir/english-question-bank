{
  "$id": "paper-presentation-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicationGivens": { "const": "validated_source_roles_only" },
    "continuationStarters": { "const": "validated_source_refs_in_response" },
    "fixedPagePlanning": {
      "additionalProperties": false,
      "properties": {
        "coverGapCandidatesPt": { "const": [[72, 72], [54, 72], [54, 54], [18, 36], [0, 18], [-25.5, 18]] },
        "historicalExplicitPlans": { "const": "digest_bound_replay_without_pixel_identity_guarantee" },
        "optionBankFallback": { "const": "protected_first_then_split_between_complete_options_for_8_or_10_pages" },
        "renderBudget": { "const": 24 },
        "splitPenalty": { "const": "measured_content_outside_main_page_in_line_height_units" }
      },
      "required": ["coverGapCandidatesPt", "historicalExplicitPlans", "optionBankFallback", "renderBudget", "splitPenalty"],
      "type": "object"
    },
    "history": { "const": "preserve_source_semantic_occurrence_and_pagination_plan_signatures" },
    "listeningRhythm": {
      "additionalProperties": false,
      "properties": {
        "exampleBeforePt": { "const": 9 },
        "exampleToQuestionsPt": { "const": 18 },
        "instructionToFirstSectionPt": { "const": 9 },
        "listeningToReadingPt": { "const": 36 },
        "noticeAndSectionBoundaryPt": { "const": 18 },
        "questionStepPt": { "const": 18 },
        "segmentCueBeforePt": { "const": 18 }
      },
      "required": ["exampleBeforePt", "exampleToQuestionsPt", "instructionToFirstSectionPt", "listeningToReadingPt", "noticeAndSectionBoundaryPt", "questionStepPt", "segmentCueBeforePt"],
      "type": "object"
    },
    "overflow": { "const": "measured_atomic_page_bounds" },
    "owner": { "const": "renderer_typography" },
    "schemaVersion": { "const": "paper-presentation-v2" },
    "sevenChoicesBlankResidue": { "const": "paired_three_underscores" },
    "version": { "const": "2" },
    "writingNotices": { "const": "source_preserved_combined_or_consecutive_numbered_blocks_shared_by_admission_and_renderers" }
  },
  "required": ["schemaVersion", "owner", "version", "continuationStarters", "applicationGivens", "sevenChoicesBlankResidue", "overflow", "history", "listeningRhythm", "writingNotices", "fixedPagePlanning"],
  "type": "object"
}
