{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderer-typography-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "owner",
    "paper",
    "projectionContract",
    "rules",
    "coordinates",
    "readingPassageLetters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "renderer-typography-v3"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "const": "3"
    },
    "owner": {
      "const": "renderer_typography"
    },
    "paper": {
      "type": "string"
    },
    "projectionContract": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionStemAndOuterOptionBlockStartTwip"
      ],
      "properties": {
        "questionStemAndOuterOptionBlockStartTwip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readingPassageLetters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotIdentity",
        "horizontalPlacement",
        "fontSizePt",
        "lineHeightPt",
        "fontWeight",
        "marginBeforePt",
        "marginAfterPt",
        "precedingGeometry",
        "referenceMeasurement"
      ],
      "properties": {
        "slotIdentity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
              "required": [
                "slotId",
                "letter",
                "precedingKind"
            ],
            "properties": {
              "slotId": {
                "type": "string"
              },
              "letter": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "precedingKind": {
                "enum": [
                  "reading_heading",
                  "prior_content"
                ]
              }
            }
          }
        },
        "horizontalPlacement": {
          "const": "reading_content_column_center"
        },
        "fontSizePt": {
          "type": "number",
          "minimum": 0
        },
        "lineHeightPt": {
          "type": "number",
          "minimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 0
        },
        "marginBeforePt": {
          "type": "number",
          "minimum": 0
        },
        "marginAfterPt": {
          "type": "number",
          "minimum": 0
        },
        "precedingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizationRule",
            "readingHeading",
            "priorContent"
          ],
          "properties": {
            "normalizationRule": {
              "const": "reference_px_1_to_1_screen_css_px_and_0_75pt_per_pdf_css_px"
            },
            "readingHeading": {
              "$ref": "#/$defs/precedingGeometryContext"
            },
            "priorContent": {
              "$ref": "#/$defs/precedingGeometryContext"
            }
          }
        },
        "referenceMeasurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "precedingGeometryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceInkGapPx",
        "referenceTolerancePx",
        "screenInkGapPx",
        "screenTolerancePx",
        "screenBeforeAdjustmentPx",
        "pdfInkGapPt",
        "pdfTolerancePt",
        "pdfBeforePaddingPt"
      ],
      "properties": {
        "referenceInkGapPx": {
          "type": "number",
          "minimum": 0
        },
        "referenceTolerancePx": {
          "type": "number",
          "minimum": 0
        },
        "screenInkGapPx": {
          "type": "number",
          "minimum": 0
        },
        "screenTolerancePx": {
          "type": "number",
          "minimum": 0
        },
        "screenBeforeAdjustmentPx": {
          "type": "number"
        },
        "pdfInkGapPt": {
          "type": "number",
          "minimum": 0
        },
        "pdfTolerancePt": {
          "type": "number",
          "minimum": 0
        },
        "pdfBeforePaddingPt": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
