{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderer-typography-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "owner",
    "paper",
    "projectionContract",
    "rules",
    "coordinates",
    "readingPassageLetters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "renderer-typography-v3"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "const": "3"
    },
    "owner": {
      "const": "renderer_typography"
    },
    "paper": {
      "type": "string"
    },
    "projectionContract": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionStemAndOuterOptionBlockStartTwip"
      ],
      "properties": {
        "questionStemAndOuterOptionBlockStartTwip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readingPassageLetters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotIdentity",
        "horizontalPlacement",
        "fontSizePt",
        "lineHeightPt",
        "fontWeight",
        "marginBeforePt",
        "marginAfterPt",
        "precedingGeometry",
        "followingGeometry",
        "referenceMeasurement"
      ],
      "properties": {
        "slotIdentity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
              "required": [
                "slotId",
                "letter",
                "precedingKindByConsumer"
            ],
            "properties": {
              "slotId": {
                "type": "string"
              },
              "letter": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "precedingKindByConsumer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "screen",
                  "print_pdf"
                ],
                "properties": {
                  "screen": {
                    "enum": [
                      "reading_heading",
                      "prior_content"
                    ]
                  },
                  "print_pdf": {
                    "const": "reading_heading"
                  }
                }
              }
            }
          }
        },
        "horizontalPlacement": {
          "const": "reading_content_column_center"
        },
        "fontSizePt": {
          "type": "number",
          "minimum": 0
        },
        "lineHeightPt": {
          "type": "number",
          "minimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 0
        },
        "marginBeforePt": {
          "type": "number",
          "minimum": 0
        },
        "marginAfterPt": {
          "type": "number",
          "minimum": 0
        },
        "precedingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizationRule",
            "readingHeading",
            "priorContent"
          ],
          "properties": {
            "normalizationRule": {
              "const": "local_baseline_step_ratio_mapped_to_actual_rendered_line_step"
            },
            "readingHeading": {
              "$ref": "#/$defs/precedingGeometryContext"
            },
            "priorContent": {
              "$ref": "#/$defs/precedingGeometryContext"
            }
          }
        },
        "followingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceBaselineStepRatio",
            "referenceRatioTolerance",
            "screenBaselineStepPx",
            "screenTolerancePx",
            "pdfBaselineStepPt",
            "pdfTolerancePt"
          ],
          "properties": {
            "referenceBaselineStepRatio": {
              "const": 1
            },
            "referenceRatioTolerance": {
              "type": "number",
              "minimum": 0
            },
            "screenBaselineStepPx": {
              "type": "number",
              "minimum": 0
            },
            "screenTolerancePx": {
              "type": "number",
              "minimum": 0
            },
            "pdfBaselineStepPt": {
              "type": "number",
              "minimum": 0
            },
            "pdfTolerancePt": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "referenceMeasurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "precedingGeometryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceBaselineStepRatio",
        "referenceRatioTolerance",
        "screenBaselineStepPx",
        "screenTolerancePx",
        "screenBeforeAdjustmentPx",
        "pdfBaselineStepPt",
        "pdfTolerancePt",
        "pdfBeforeAdjustmentPt"
      ],
      "properties": {
        "referenceBaselineStepRatio": {
          "type": "number",
          "minimum": 0
        },
        "referenceRatioTolerance": {
          "type": "number",
          "minimum": 0
        },
        "screenBaselineStepPx": {
          "type": "number",
          "minimum": 0
        },
        "screenTolerancePx": {
          "type": "number",
          "minimum": 0
        },
        "screenBeforeAdjustmentPx": {
          "type": "number"
        },
        "pdfBaselineStepPt": {
          "type": "number",
          "minimum": 0
        },
        "pdfTolerancePt": {
          "type": "number",
          "minimum": 0
        },
        "pdfBeforeAdjustmentPt": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
