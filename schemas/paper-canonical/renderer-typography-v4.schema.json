{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderer-typography-v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "owner",
    "paper",
    "projectionContract",
    "rules",
    "coordinates",
    "readingPassageLetters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "renderer-typography-v4"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "const": "4"
    },
    "owner": {
      "const": "renderer_typography"
    },
    "paper": {
      "type": "string"
    },
    "projectionContract": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionStemAndOuterOptionBlockStartTwip"
      ],
      "properties": {
        "questionStemAndOuterOptionBlockStartTwip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readingPassageLetters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotIdentity",
        "horizontalPlacement",
        "fontSizePt",
        "lineHeightPt",
        "fontWeight",
        "marginBeforePt",
        "marginAfterPt",
        "precedingGeometry",
        "followingGeometry",
        "verticalRhythm",
        "referenceMeasurement"
      ],
      "properties": {
        "slotIdentity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slotId",
              "letter",
              "precedingKindByConsumer"
            ],
            "properties": {
              "slotId": {
                "type": "string"
              },
              "letter": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "precedingKindByConsumer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "screen",
                  "print_pdf"
                ],
                "properties": {
                  "screen": {
                    "enum": [
                      "reading_heading",
                      "prior_question_tail"
                    ]
                  },
                  "print_pdf": {
                    "enum": [
                      "reading_heading",
                      "prior_question_tail"
                    ]
                  }
                }
              }
            }
          }
        },
        "horizontalPlacement": {
          "const": "reading_content_column_center"
        },
        "fontSizePt": {
          "type": "number",
          "minimum": 0
        },
        "lineHeightPt": {
          "type": "number",
          "minimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 0
        },
        "marginBeforePt": {
          "type": "number",
          "minimum": 0
        },
        "marginAfterPt": {
          "type": "number",
          "minimum": 0
        },
        "precedingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizationRule",
            "readingHeading",
            "priorQuestionTail"
          ],
          "properties": {
            "normalizationRule": {
              "const": "local_baseline_step_ratio_mapped_to_actual_rendered_line_step"
            },
            "readingHeading": {
              "$ref": "#/$defs/precedingGeometryContext"
            },
            "priorQuestionTail": {
              "$ref": "#/$defs/precedingGeometryContext"
            }
          }
        },
        "followingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceBaselineStepRatio",
            "referenceRatioTolerance",
            "screenBaselineStepPx",
            "screenTolerancePx",
            "pdfBaselineStepPt",
            "pdfTolerancePt"
          ],
          "properties": {
            "referenceBaselineStepRatio": {
              "const": 1
            },
            "referenceRatioTolerance": {
              "type": "number",
              "minimum": 0
            },
            "screenBaselineStepPx": {
              "type": "number",
              "minimum": 0
            },
            "screenTolerancePx": {
              "type": "number",
              "minimum": 0
            },
            "pdfBaselineStepPt": {
              "type": "number",
              "minimum": 0
            },
            "pdfTolerancePt": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "verticalRhythm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticRoleClasses",
            "adjacencyGraph",
            "targets"
          ],
          "properties": {
            "semanticRoleClasses": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chrome",
                "passageContent",
                "questionStem",
                "optionLine",
                "teacherTail"
              ],
              "properties": {
                "chrome": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "passageContent": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "questionStem": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "optionLine": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "teacherTail": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                }
              }
            },
            "adjacencyGraph": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "edgeId",
                  "optionalCollapse"
                ],
                "properties": {
                  "edgeId": {
                    "type": "string"
                  },
                  "fromClass": {
                    "type": "string"
                  },
                  "fromRole": {
                    "type": "string"
                  },
                  "toClass": {
                    "type": "string"
                  },
                  "toRole": {
                    "type": "string"
                  },
                  "baselineStepRatio": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pageRelation": {
                    "enum": [
                      "next_page_continuation",
                      "next_page_start"
                    ]
                  },
                  "optionalCollapse": {
                    "type": "boolean"
                  },
                  "repeatForbiddenRoles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "screen",
                "printPdf"
              ],
              "properties": {
                "screen": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baselineStepPx",
                    "oneStepTolerancePx",
                    "twoStepTolerancePx"
                  ],
                  "properties": {
                    "baselineStepPx": {
                      "type": "number",
                      "minimum": 0
                    },
                    "oneStepTolerancePx": {
                      "type": "number",
                      "minimum": 0
                    },
                    "twoStepTolerancePx": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "printPdf": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baselineStepPt",
                    "oneStepTolerancePt",
                    "twoStepTolerancePt"
                  ],
                  "properties": {
                    "baselineStepPt": {
                      "type": "number",
                      "minimum": 0
                    },
                    "oneStepTolerancePt": {
                      "type": "number",
                      "minimum": 0
                    },
                    "twoStepTolerancePt": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "referenceMeasurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyRoleArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "precedingGeometryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceBaselineStepRatio",
        "referenceRatioTolerance",
        "screenBaselineStepPx",
        "screenTolerancePx",
        "screenBeforeAdjustmentPx",
        "pdfBaselineStepPt",
        "pdfTolerancePt",
        "pdfBeforeAdjustmentPt"
      ],
      "properties": {
        "referenceBaselineStepRatio": {
          "type": "number",
          "minimum": 0
        },
        "referenceRatioTolerance": {
          "type": "number",
          "minimum": 0
        },
        "screenBaselineStepPx": {
          "type": "number",
          "minimum": 0
        },
        "screenTolerancePx": {
          "type": "number",
          "minimum": 0
        },
        "screenBeforeAdjustmentPx": {
          "type": "number"
        },
        "pdfBaselineStepPt": {
          "type": "number",
          "minimum": 0
        },
        "pdfTolerancePt": {
          "type": "number",
          "minimum": 0
        },
        "pdfBeforeAdjustmentPt": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
