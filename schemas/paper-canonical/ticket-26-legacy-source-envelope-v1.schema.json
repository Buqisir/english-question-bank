{
  "$id": "ticket-26-legacy-source-envelope-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "ticket-26-legacy-source-envelope-v1" },
    "sourceCaptureDocument": {
      "additionalProperties": false,
      "properties": {
        "byteLength": { "minimum": 1, "type": "integer" },
        "inputKey": { "type": "string" },
        "mediaType": { "const": "application/vnd.eqb.ticket-26-source-capture+json" },
        "sha256": { "type": "string" }
      },
      "required": ["inputKey", "mediaType", "sha256", "byteLength"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "sourceCaptureDocument"],
  "type": "object"
}
