{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuation-writing-source-capture-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paperId",
    "profileId",
    "sourceDocumentDigest",
    "review",
    "lineage",
    "group"
  ],
  "properties": {
    "schemaVersion": {
      "const": "continuation-writing-source-capture-v2"
    },
    "paperId": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "sourceDocumentDigest": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "status"
      ],
      "properties": {
        "method": {
          "const": "manual_source_review"
        },
        "status": {
          "const": "accepted"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "predecessor",
        "sourceTextNormalization",
        "preservedDistinctions"
      ],
      "properties": {
        "kind": {
          "const": "immutable_source_fidelity_successor"
        },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "sha256"
          ],
          "properties": {
            "schemaVersion": {
              "const": "continuation-writing-source-capture-v1"
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "sourceTextNormalization": {
          "const": "unicode_nfc_ascii_whitespace_collapse_v1"
        },
        "preservedDistinctions": {
          "type": "array",
          "items": {
            "enum": [
              "punctuation_code_points",
              "punctuation_adjacent_spacing",
              "apostrophe_code_points",
              "word_presence"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "slotId",
        "sourceLocation",
        "content",
        "variant",
        "observations"
      ],
      "properties": {
        "groupId": {
          "type": "string"
        },
        "slotId": {
          "const": "writing.continuation"
        },
        "sourceLocation": {
          "type": "object"
        },
        "content": {
          "type": "object"
        },
        "variant": {
          "type": "object"
        },
        "observations": {
          "type": "array"
        }
      }
    }
  }
}
