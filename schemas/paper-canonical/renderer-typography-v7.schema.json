{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "renderer-typography-v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "owner",
    "paper",
    "projectionContract",
    "rules",
    "coordinates",
    "readingPassageLetters",
    "sectionHeadingContract",
    "optionAnchorFramework"
  ],
  "properties": {
    "schemaVersion": {
      "const": "renderer-typography-v7"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "const": "7"
    },
    "owner": {
      "const": "renderer_typography"
    },
    "paper": {
      "type": "string"
    },
    "projectionContract": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionStemAndOuterOptionBlockStartTwip"
      ],
      "properties": {
        "questionStemAndOuterOptionBlockStartTwip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readingPassageLetters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotIdentity",
        "horizontalPlacement",
        "fontSizePt",
        "lineHeightPt",
        "fontWeight",
        "marginBeforePt",
        "marginAfterPt",
        "precedingGeometry",
        "followingGeometry",
        "verticalRhythm",
        "referenceMeasurement"
      ],
      "properties": {
        "slotIdentity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slotId",
              "letter",
              "precedingKindByConsumer"
            ],
            "properties": {
              "slotId": {
                "type": "string"
              },
              "letter": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "precedingKindByConsumer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "screen",
                  "print_pdf"
                ],
                "properties": {
                  "screen": {
                    "enum": [
                      "reading_heading",
                      "prior_question_tail"
                    ]
                  },
                  "print_pdf": {
                    "enum": [
                      "reading_heading",
                      "prior_question_tail"
                    ]
                  }
                }
              }
            }
          }
        },
        "horizontalPlacement": {
          "const": "reading_content_column_center"
        },
        "fontSizePt": {
          "type": "number",
          "minimum": 0
        },
        "lineHeightPt": {
          "type": "number",
          "minimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 0
        },
        "marginBeforePt": {
          "type": "number",
          "minimum": 0
        },
        "marginAfterPt": {
          "type": "number",
          "minimum": 0
        },
        "precedingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizationRule",
            "readingHeading",
            "priorQuestionTail"
          ],
          "properties": {
            "normalizationRule": {
              "const": "local_baseline_step_ratio_mapped_to_actual_rendered_line_step"
            },
            "readingHeading": {
              "$ref": "#/$defs/precedingGeometryContext"
            },
            "priorQuestionTail": {
              "$ref": "#/$defs/precedingGeometryContext"
            }
          }
        },
        "followingGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceBaselineStepRatio",
            "referenceRatioTolerance",
            "screenBaselineStepPx",
            "screenTolerancePx",
            "pdfBaselineStepPt",
            "pdfTolerancePt"
          ],
          "properties": {
            "referenceBaselineStepRatio": {
              "const": 1
            },
            "referenceRatioTolerance": {
              "type": "number",
              "minimum": 0
            },
            "screenBaselineStepPx": {
              "type": "number",
              "minimum": 0
            },
            "screenTolerancePx": {
              "type": "number",
              "minimum": 0
            },
            "pdfBaselineStepPt": {
              "type": "number",
              "minimum": 0
            },
            "pdfTolerancePt": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "verticalRhythm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticRoleClasses",
            "adjacencyGraph",
            "targets"
          ],
          "properties": {
            "semanticRoleClasses": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chrome",
                "passageContent",
                "questionStem",
                "optionLine",
                "teacherTail"
              ],
              "properties": {
                "chrome": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "passageContent": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "questionStem": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "optionLine": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                },
                "teacherTail": {
                  "$ref": "#/$defs/nonEmptyRoleArray"
                }
              }
            },
            "adjacencyGraph": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "edgeId",
                  "optionalCollapse"
                ],
                "properties": {
                  "edgeId": {
                    "type": "string"
                  },
                  "fromClass": {
                    "type": "string"
                  },
                  "fromRole": {
                    "type": "string"
                  },
                  "toClass": {
                    "type": "string"
                  },
                  "toRole": {
                    "type": "string"
                  },
                  "baselineStepRatio": {
                    "type": "number",
                    "minimum": 0
                  },
                  "pageRelation": {
                    "enum": [
                      "next_page_continuation",
                      "next_page_start"
                    ]
                  },
                  "optionalCollapse": {
                    "type": "boolean"
                  },
                  "repeatForbiddenRoles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "screen",
                "printPdf"
              ],
              "properties": {
                "screen": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baselineStepPx",
                    "oneStepTolerancePx",
                    "twoStepTolerancePx"
                  ],
                  "properties": {
                    "baselineStepPx": {
                      "type": "number",
                      "minimum": 0
                    },
                    "oneStepTolerancePx": {
                      "type": "number",
                      "minimum": 0
                    },
                    "twoStepTolerancePx": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "printPdf": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "baselineStepPt",
                    "oneStepTolerancePt",
                    "twoStepTolerancePt"
                  ],
                  "properties": {
                    "baselineStepPt": {
                      "type": "number",
                      "minimum": 0
                    },
                    "oneStepTolerancePt": {
                      "type": "number",
                      "minimum": 0
                    },
                    "twoStepTolerancePt": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "referenceMeasurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    },
    "sectionHeadingContract": {
      "const": {
        "contractId": "nck1-section-heading-owner-gold",
        "version": "1",
        "scope": {
          "profileId": "nck1",
          "activeSectionHeadingCount": 6,
          "surfaces": [
            "screen_plain",
            "screen_lecture",
            "print_html_student",
            "print_html_teacher",
            "pdf_student",
            "pdf_teacher"
          ]
        },
        "horizontalAnchors": {
          "partHeadingIndentEm": 0,
          "sectionHeadingIndentEm": 0,
          "groupInstructionFirstLineIndentEm": 2,
          "passageFirstLineIndentEm": 2,
          "passageContinuationIndentEm": 0
        },
        "typography": {
          "fontStack": "\"SimSun\", \"Songti SC\", \"STSong\", serif",
          "singleFontStackForDigitsAndChinese": true,
          "sharedBaseline": true,
          "numericRunBaselineShiftEm": 0.2,
          "visualAlignment": "numeric_and_chinese_visible_bottoms_match",
          "fontSizePt": 10.5,
          "lineHeightPt": 18
        },
        "textRules": {
          "asciiSpaceAfterSectionOrdinal": 1,
          "asciiSpaceBetweenNumberAndChineseUnit": 1,
          "preserveFullWidthChineseParentheses": true,
          "preserveFullWidthChineseSemicolon": true,
          "preserveFullWidthChineseComma": true
        },
        "evidence": [
          {
            "role": "current_defect",
            "path": "docs/cuts/paper-canonical-unification/qa/20-section-heading-current-defect.png",
            "sha256": "sha256:4d0f8c598db32f63df6995bf3d586d188753d333dd47eb1ac5742ec79027a3c3"
          },
          {
            "role": "gold_typography",
            "path": "docs/cuts/paper-canonical-unification/qa/20-section-heading-gold-typography.png",
            "sha256": "sha256:d1e4bcc5572074f978d37a638c15c17dec52b134ee4e8f82800442ef25358ba6"
          },
          {
            "role": "gold_horizontal_anchors",
            "path": "docs/cuts/paper-canonical-unification/qa/20-section-heading-gold-anchors.png",
            "sha256": "sha256:c161f76085ea6f1b46d3070cb54e678cf65c636ae313df887a8c573f4c0e5951"
          }
        ]
      }
    },
    "optionAnchorFramework": {
      "const": {
        "rowWidthTwip": 8764,
        "reading": {
          "fourColumnStartsTwip": [
            0,
            2080,
            4160,
            6240
          ],
          "twoColumnStartsTwip": [
            0,
            4160
          ],
          "sharedMidAnchorUsableWidthRatio": 0.4746691011
        },
        "cloze": {
          "questionLabelStartTwip": 0,
          "optionColumnStartsTwip": [
            346,
            2556,
            4638,
            6731
          ],
          "optionColumnWidthsTwip": [
            2210,
            2082,
            2093,
            2033
          ],
          "labelToTextGapEm": 0.411765
        },
        "visibleWeight": {
          "questionNumber": 400,
          "optionLabel": 400,
          "optionText": 400
        }
      }
    }
  },
  "$defs": {
    "nonEmptyRoleArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "precedingGeometryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceBaselineStepRatio",
        "referenceRatioTolerance",
        "screenBaselineStepPx",
        "screenTolerancePx",
        "screenBeforeAdjustmentPx",
        "pdfBaselineStepPt",
        "pdfTolerancePt",
        "pdfBeforeAdjustmentPt"
      ],
      "properties": {
        "referenceBaselineStepRatio": {
          "type": "number",
          "minimum": 0
        },
        "referenceRatioTolerance": {
          "type": "number",
          "minimum": 0
        },
        "screenBaselineStepPx": {
          "type": "number",
          "minimum": 0
        },
        "screenTolerancePx": {
          "type": "number",
          "minimum": 0
        },
        "screenBeforeAdjustmentPx": {
          "type": "number"
        },
        "pdfBaselineStepPt": {
          "type": "number",
          "minimum": 0
        },
        "pdfTolerancePt": {
          "type": "number",
          "minimum": 0
        },
        "pdfBeforeAdjustmentPt": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
