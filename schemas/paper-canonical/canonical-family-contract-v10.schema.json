  "required": ["schemaVersion", "familyContractId", "version", "owner", "choiceOwnership", "questionCardinality", "blankCardinality", "variantStatus", "variantSchemaId"],
  "properties": {
    "schemaVersion": { "const": "canonical-family-contract-v10" },
    "familyContractId": { "const": "reading" },
    "version": { "const": "2" },
    "owner": { "const": "family" },
    "choiceOwnership": { "const": "per_question" },
    "questionCardinality": { "const": "profile_bound" },
    "blankCardinality": { "const": "none" },
    "variantStatus": { "const": "closed" },
    "variantSchemaId": { "const": "canonical-reading-variant-v1" }
  }
}
