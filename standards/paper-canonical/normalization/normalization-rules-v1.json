        "structural_tokenization": {"kind":"source_identity","observationArity":1},
        "exact_join": {"kind":"unique_observation_join","observationArity":2},
        "anchor_identity": {"kind":"source_identity","observationArity":1}
      }
    },
    {
      "ruleId": "guarded-representation-normalization",
      "version": "1",
      "certainty": "exact",
      "allowedOperations": ["representation_normalization"],
      "operationProofs": {
        "representation_normalization": {"kind":"source_identity","observationArity":1}
      }
    }
  ]
}
