    "numberAlignment": "center",
    "whiteSpace": "nowrap",
    "verticalSpaceContribution": 0,
    "punctuationOwnership": "passage_text_outside_blank",
    "atomicity": "inline_block_unbreakable"
  },
  "horizontalChoiceGeometry": {
