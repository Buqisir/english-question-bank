  "targets": {
    "screen": {
      "baselineStepPx": 24,
      "oneStepTolerancePx": 1.5,
      "threeHalfStepTolerancePx": 1.5,
      "twoStepTolerancePx": 1.5
    },
    "printPdf": {
      "baselineStepPt": 18,
      "oneStepTolerancePt": 1.5,
      "threeHalfStepTolerancePt": 1.5,
      "twoStepTolerancePt": 1.5
    }
  },
  "blankGeometry": {
