{
  "schemaVersion": "cloze-rhythm-v3",
  "id": "cloze-rhythm",
  "version": "3",
  "owner": "renderer_typography",
  "paper": "a4",
  "projectionContract": "canonical-projector-v1",
  "rules": [
    "typography_never_changes_canonical_text",
    "inline_blank_width_is_3_3em_class",
    "inline_blank_number_is_centered",
    "inline_blank_markers_add_no_vertical_space",
    "inline_blank_punctuation_remains_outside",
    "inline_blank_units_are_atomic",
    "source_cloze_rows_use_one_gold_normalized_four_column_plan",
    "choice_row_question_anchor_matches_passage_continuation_anchor",
    "question_number_and_first_option_have_no_extra_inter_token_gap",
    "question_number_option_label_and_option_text_use_regular_weight",
    "option_label_and_text_are_atomic",
    "choice_rows_are_unsplittable",
    "optional_roles_collapse_without_phantom_space",
    "previous_family_identity_remains_seven_choices_owned"
  ],
  "semanticRoleClasses": {
    "previousFamilyBoundary": [
      "previous_family_tail"
    ],
    "chrome": [
      "part_title",
      "subsection",
      "meta_instruction"
    ],
    "passageContent": [
      "passage_body_line"
    ],
    "inlineBlank": [
      "inline_blank_marker"
    ],
    "choiceRow": [
      "choice_row"
    ],
    "choiceLabel": [
      "choice_label"
    ],
    "choiceText": [
      "choice_text"
    ],
    "teacherTail": [
      "answer_line",
      "explanation_line"
    ],
    "followingSection": [
      "next_section"
    ]
  },
  "adjacencyGraph": [
