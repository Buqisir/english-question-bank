    "strategy": {
      "questionLabel": "fixed_leading_anchor",
      "optionColumns": "four_gold_normalized_fixed_origin_tracks",
      "optionLabel": "fixed_anchor_per_track",
      "optionTextStart": "after_label_glyph_plus_fixed_gap",
      "gutter": "fixed_minimum_gutter_not_distributed",
      "trailingCapacity": "final_track_consumes_remaining_width_without_moving_origins",
      "distribution": "not_distributed_not_space_between",
      "wrappedContinuation": "hanging_indent_at_option_text_start",
      "hybridRows": "forbidden",
      "shrinkToFit": false
