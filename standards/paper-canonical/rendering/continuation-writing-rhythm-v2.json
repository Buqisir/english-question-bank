      "optionalCollapse": false
    },
    {
      "edgeId": "response_normal_flow",
      "fromRole": "response_box",
      "toRole": "response_box",
      "pageRelation": "normal_flow_not_application_atomicity",
      "optionalCollapse": false
    },
    {
      "edgeId": "response_move_next_page",
      "fromRole": "response_box",
      "toRole": "response_box",
      "pageRelation": "next_page_preserve_starter_offsets",
      "optionalCollapse": false
    },
    {
      "edgeId": "response_to_starter_1",
      "fromRole": "response_box",
      "toRole": "starter_1",
      "verticalRelation": "first_half_top_inset",
      "optionalCollapse": false
    },
    {
      "edgeId": "starter_1_first_line_indent",
      "fromRole": "response_box",
      "toRole": "starter_1",
      "horizontalRelation": "four_local_em_from_border",
      "optionalCollapse": false
    },
    {
      "edgeId": "starter_1_to_writable_area",
      "fromRole": "starter_1",
      "toRole": "writable_after_starter_1",
      "verticalRelation": "same_half_remaining_area",
      "optionalCollapse": false
    },
    {
      "edgeId": "writable_area_to_starter_2",
      "fromRole": "writable_after_starter_1",
      "toRole": "starter_2",
      "verticalRelation": "second_half_start",
      "optionalCollapse": false
    },
    {
      "edgeId": "starter_2_first_line_indent",
      "fromRole": "response_box",
      "toRole": "starter_2",
      "horizontalRelation": "four_local_em_from_border",
      "optionalCollapse": false
    },
    {
      "edgeId": "starter_2_to_writable_area",
      "fromRole": "starter_2",
      "toRole": "writable_after_starter_2",
      "verticalRelation": "same_half_remaining_area",
      "optionalCollapse": false
    },
    {
      "edgeId": "starter_wrapped_hanging_origin",
      "fromClass": "suppliedStarter",
      "toClass": "suppliedStarter",
      "horizontalRelation": "all_wrapped_lines_share_starter_text_origin",
      "optionalCollapse": false
    },
    {
      "edgeId": "teacher_tail_absence_collapse",
      "fromRole": "response_box",
      "toRole": "paper_end",
      "extraBaselineStepRatio": 0,
      "optionalCollapse": true
    },
    {
      "edgeId": "response_to_paper_end",
      "fromRole": "response_box",
      "toRole": "paper_end",
      "pageRelation": "same_or_next_page_after_complete_response",
      "optionalCollapse": false
    }
  ],
  "targets": {
    "screen": {
      "baselineStepPx": 24,
      "oneStepTolerancePx": 1.5,
      "starterIndentTolerancePx": 1.5
    },
    "printPdf": {
      "baselineStepPt": 18,
      "oneStepTolerancePt": 1.5,
      "starterIndentTolerancePt": 1.5
    }
  },
  "responseGeometry": {
    "physicalAuthority": {
      "path": "docs/product/exam-paper-format-standards.md",
      "section": "8. 写作答题区"
    },
    "widthMm": 145,
    "heightMm": 57,
    "borderPt": 0.48,
    "pagination": "normal_flow_preserve_starter_offsets",
    "horizontalAlignment": "center",
    "studentWritableArea": "remaining_area_after_each_supplied_starter"
  },
  "starterGeometry": {
    "firstLineIndentEm": 4,
    "firstLineIndentToleranceEm": 0.1,
    "indentUsableWidthRatio": 0.102,
    "indentUsableWidthRatioTolerance": 0.003,
    "rowTopInsetEm": 1,
    "secondRowStartRatio": 0.5,
    "trailingInsetEm": 1,
    "wrappedLineStrategy": "hanging_at_first_line_text_origin"
  },
  "rendererMapping": {
    "screen": {
      "pageBlockGapPx": 12,
      "responseMarginTopPx": 14,
      "responsePaddingTopBottomPx": 20,
      "responsePaddingLeftRightPx": 24
