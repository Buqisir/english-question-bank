{
  "schemaVersion": "continuation-writing-rhythm-v2",
  "id": "continuation-writing-rhythm",
  "version": "2",
  "owner": "renderer_typography",
  "paper": "a4",
  "projectionContract": "canonical-projector-v1",
  "rules": [
    "typography_never_changes_canonical_text",
    "visible_order_is_source_and_profile_owned",
    "supplied_starters_are_source_owned",
    "starter_first_line_indent_is_renderer_geometry",
    "both_starters_share_one_indent_origin",
    "student_writable_area_is_not_a_supplied_starter",
    "normal_flow_preserves_starter_offsets_across_page_movement",
    "teacher_material_requires_reviewed_source_authority",
    "paper_end_remains_after_the_complete_response"
  ],
  "semanticRoleClasses": {
    "previousFamilyBoundary": [
      "application_response",
      "application_teacher_tail"
    ],
    "chrome": [
      "part_heading",
      "section_heading",
      "instruction"
    ],
    "material": [
      "material_paragraph"
    ],
    "responseRegion": [
      "response_box"
    ],
    "suppliedStarter": [
      "starter_1",
      "starter_2"
    ],
    "studentWritableArea": [
      "writable_after_starter_1",
      "writable_after_starter_2"
    ],
    "teacherTail": [
      "reference_answer",
      "analysis_line",
      "rubric_line"
    ],
    "followingBoundary": [
      "paper_end"
    ]
  },
  "adjacencyGraph": [
    {
      "edgeId": "application_boundary_to_section",
      "fromClass": "previousFamilyBoundary",
      "toRole": "section_heading",
      "pageRelation": "same_or_next_page",
      "optionalCollapse": false
    },
    {
      "edgeId": "section_to_instruction",
      "fromRole": "section_heading",
      "toRole": "instruction",
      "baselineStepRatio": 1,
      "optionalCollapse": false
    },
    {
      "edgeId": "instruction_to_material",
      "fromRole": "instruction",
      "toRole": "material_paragraph",
      "baselineStepRatio": 1,
      "optionalCollapse": false
    },
    {
      "edgeId": "material_paragraph_internal",
      "fromRole": "material_paragraph",
      "toRole": "material_paragraph",
      "baselineStepRatio": 1,
      "optionalCollapse": false
    },
    {
      "edgeId": "material_wrapped_continuation",
      "fromRole": "material_paragraph",
      "toRole": "material_paragraph",
      "pageRelation": "same_paragraph_wrapped_or_next_page_continuation",
