{
  "schemaVersion": "renderer-typography-v3",
  "id": "paper-typography",
  "version": "3",
  "owner": "renderer_typography",
  "paper": "a4",
  "projectionContract": "canonical-projector-v1",
  "rules": [
    "typography_never_changes_canonical_text",
    "blank_geometry_is_renderer_owned",
    "option_layout_is_not_canonical_semantics",
    "question_stem_and_outer_option_block_share_bound_origin",
    "reading_passage_letter_comes_only_from_profile_slot_identity",
    "reading_passage_letter_renders_once_before_passage_content"
  ],
  "coordinates": {
    "questionStemAndOuterOptionBlockStartTwip": 420
  },
  "readingPassageLetters": {
    "slotIdentity": [
      {
        "slotId": "reading.a",
        "letter": "A",
        "precedingKindByConsumer": {
          "screen": "reading_heading",
          "print_pdf": "reading_heading"
        }
      },
      {
        "slotId": "reading.b",
        "letter": "B",
        "precedingKindByConsumer": {
          "screen": "prior_content",
          "print_pdf": "reading_heading"
        }
      },
      {
        "slotId": "reading.c",
        "letter": "C",
        "precedingKindByConsumer": {
          "screen": "prior_content",
          "print_pdf": "reading_heading"
        }
      },
      {
        "slotId": "reading.d",
        "letter": "D",
        "precedingKindByConsumer": {
          "screen": "prior_content",
          "print_pdf": "reading_heading"
        }
      }
    ],
    "horizontalPlacement": "reading_content_column_center",
    "fontSizePt": 10.5,
    "lineHeightPt": 18,
    "fontWeight": 700,
    "marginBeforePt": 0,
    "marginAfterPt": 0,
    "precedingGeometry": {
      "normalizationRule": "local_baseline_step_ratio_mapped_to_actual_rendered_line_step",
      "readingHeading": {
        "referenceBaselineStepRatio": 1,
        "referenceRatioTolerance": 0.05,
        "screenBaselineStepPx": 24,
        "screenTolerancePx": 1.25,
        "screenBeforeAdjustmentPx": -13,
        "pdfBaselineStepPt": 18,
        "pdfTolerancePt": 1,
        "pdfBeforeAdjustmentPt": -4.5
      },
      "priorContent": {
        "referenceBaselineStepRatio": 2,
        "referenceRatioTolerance": 0.05,
        "screenBaselineStepPx": 48,
        "screenTolerancePx": 1.25,
        "screenBeforeAdjustmentPx": 13,
        "pdfBaselineStepPt": 36,
        "pdfTolerancePt": 1,
        "pdfBeforeAdjustmentPt": null
      }
    },
    "followingGeometry": {
      "referenceBaselineStepRatio": 1,
      "referenceRatioTolerance": 0.05,
      "screenBaselineStepPx": 24,
      "screenTolerancePx": 0.75,
      "pdfBaselineStepPt": 18,
      "pdfTolerancePt": 0.5
    },
    "referenceMeasurement": {
      "path": "docs/cuts/paper-canonical-unification/qa/20-reading-passage-letter-reference-measurements.json",
