      "pageRelation": "next_page_start",
      "optionalCollapse": false
    },
    {
      "edgeId": "teacher_tail_to_next_section_cross_page",
      "fromClass": "teacherTail",
      "toRole": "next_section",
      "pageRelation": "next_page_start",
      "optionalCollapse": true
    },
    {
      "edgeId": "same_passage_cross_page",
      "fromClass": "passageContent",
      "toClass": "passageContent",
      "pageRelation": "next_page_continuation",
      "optionalCollapse": false,
      "repeatForbiddenRoles": [
        "part_title",
        "subsection",
        "meta_instruction",
        "bank_heading",
        "bank_option_line"
      ]
    },
    {
      "edgeId": "bank_between_options_cross_page",
      "fromClass": "bankOption",
      "toClass": "bankOption",
      "pageRelation": "next_page_continuation",
      "optionalCollapse": false,
      "splitForbiddenRole": "bank_option_line",
      "repeatForbiddenRoles": [
        "bank_heading"
      ]
    }
  ],
  "targets": {
    "screen": {
      "baselineStepPx": 24,
      "oneStepTolerancePx": 1.5,
      "fiveQuarterStepTolerancePx": 1.5,
      "twoStepTolerancePx": 1.5
    },
    "printPdf": {
      "baselineStepPt": 18,
      "oneStepTolerancePt": 1.5,
      "fiveQuarterStepTolerancePt": 1.5,
      "twoStepTolerancePt": 1.5
    }
  },
  "goldenGeometryFramework": {
    "id": "golden-geometry-framework-v1",
    "path": "docs/cuts/paper-canonical-unification/qa/golden-geometry-framework-v1.md",
    "sha256": "sha256:46fee75e0ddaa62989985c1e3dea5be11f8501324fd0a95b409b610716c0be88",
    "axes": [
      "vertical",
      "horizontal"
    ],
    "familyValuesAreNotShared": true
  },
  "horizontalBankGeometry": {
    "rowOccupancy": {
      "tracksPerRow": 1,
      "optionsPerTrack": 1,
      "columnCount": 1,
      "horizontalGutterCount": 0
    },
    "strategy": {
      "rowTrack": "fixed_single_remaining_usable_width",
      "labelAnchor": "fixed_cluster_at_row_origin",
      "textStart": "content_driven_after_label_glyph_plus_fixed_em_gap",
      "rightContentBound": "content_driven",
      "distribution": "not_distributed_not_space_between",
      "wrappedContinuation": "hanging_indent_at_each_rows_text_start",
      "goldenWrappedContinuationObservation": "unobserved_all_golden_options_are_one_line",
      "inference": "A-G expose one label-x cluster and one narrow text-start cluster while visible right bounds vary with text length. No second track cluster or length-dependent start drift exists."
    },
    "normalizedMeasurements": {
      "bankLeftInsetUsableWidthRatio": 0.052778,
      "rowTrackUsableWidthRatio": 0.947222,
      "medianLabelAnchorUsableWidthRatio": 0.052778,
      "labelAnchorClusterRangeUsableWidthRatio": 0.001389,
      "medianTextStartUsableWidthRatio": 0.083333,
      "textStartClusterRangeUsableWidthRatio": 0.006944,
      "medianLabelBoxToTextGapEm": 0.444444,
      "medianLabelToTextStartBaselineRatio": 0.709677,
      "rowBaselineAlignmentRatio": 0
    },
    "rendererMapping": {
      "screen": {
        "bankInsetEm": 2,
        "labelTextGapEm": 0.4,
        "trackWidth": "remaining_usable_content_width",
        "layout": "single_column_flex_row",
        "wrappedContinuation": "text_item_own_start"
      },
      "printPdf": {
        "bankInsetEm": 2,
        "labelTextGapEm": 0.4,
        "trackWidth": "remaining_usable_content_width",
        "layout": "single_column_flex_row",
        "wrappedContinuation": "text_item_own_start"
      }
    }
  },
  "referenceMeasurement": {
