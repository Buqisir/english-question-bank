    {
      "edgeId": "passage_to_first_option",
      "fromClass": "passageContent",
      "toClass": "bankOption",
      "baselineStepRatio": 2,
      "optionalCollapse": true
    },
    {
      "edgeId": "passage_to_bank_cross_page",
      "fromClass": "passageContent",
      "toClass": "bankOption",
      "pageRelation": "next_page_start",
      "optionalCollapse": true
    },
    {
      "edgeId": "bank_option_line_internal",
      "fromClass": "bankOption",
      "toClass": "bankOption",
      "baselineStepRatio": 1,
      "optionalCollapse": false
