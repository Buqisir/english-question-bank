{
  "schemaVersion": "seven-choices-rhythm-v2",
  "id": "seven-choices-rhythm",
  "version": "2",
  "owner": "renderer_typography",
  "paper": "a4",
  "projectionContract": "canonical-projector-v1",
  "rules": [
    "typography_never_changes_canonical_text",
    "blank_geometry_is_renderer_owned",
    "inline_blank_markers_add_no_vertical_space",
    "seven_choices_bank_renders_once_per_group",
    "seven_choices_options_never_split",
    "optional_roles_collapse_without_phantom_space",
    "reading_boundary_identity_remains_reading_owned"
  ],
  "semanticRoleClasses": {
    "readingBoundary": [
      "reading_question_tail"
    ],
    "chrome": [
      "part_title",
      "subsection",
      "meta_instruction"
    ],
    "passageContent": [
      "passage_body_line"
    ],
    "inlineBlank": [
      "inline_blank_marker"
    ],
    "bankHeading": [
      "bank_heading"
    ],
    "bankOption": [
      "bank_option_line"
    ],
    "teacherTail": [
      "answer_line",
      "explanation_line"
    ],
    "followingSection": [
      "next_section"
    ]
  },
  "adjacencyGraph": [
    {
      "edgeId": "reading_boundary_to_chrome_same_page",
      "fromClass": "readingBoundary",
      "toClass": "chrome",
      "baselineStepRatio": 2,
      "optionalCollapse": true
    },
    {
      "edgeId": "reading_boundary_to_chrome_cross_page",
      "fromClass": "readingBoundary",
      "toClass": "chrome",
      "pageRelation": "next_page_start",
      "optionalCollapse": true
    },
    {
      "edgeId": "chrome_internal",
      "fromClass": "chrome",
      "toClass": "chrome",
      "baselineStepRatio": 1,
      "optionalCollapse": true
    },
    {
      "edgeId": "chrome_to_passage",
      "fromClass": "chrome",
      "toClass": "passageContent",
      "baselineStepRatio": 1.25,
      "optionalCollapse": true
    },
    {
      "edgeId": "passage_line_internal",
      "fromRole": "passage_body_line",
      "toRole": "passage_body_line",
      "baselineStepRatio": 1,
      "optionalCollapse": false
    },
    {
      "edgeId": "paragraph_transition",
      "fromClass": "passageContent",
      "toClass": "passageContent",
      "baselineStepRatio": 1,
      "optionalCollapse": false
    },
    {
      "edgeId": "inline_blank_no_phantom_space",
      "fromRole": "passage_body_line",
      "throughClass": "inlineBlank",
