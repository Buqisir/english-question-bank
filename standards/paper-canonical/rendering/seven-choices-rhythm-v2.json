      "toRole": "answer_line",
      "baselineStepRatio": 1,
      "optionalCollapse": true
    },
    {
      "edgeId": "answer_to_explanation",
      "fromRole": "answer_line",
      "toRole": "explanation_line",
      "baselineStepRatio": 1,
      "optionalCollapse": true
    },
    {
      "edgeId": "teacher_tail_internal",
      "fromClass": "teacherTail",
      "toClass": "teacherTail",
      "baselineStepRatio": 1,
      "optionalCollapse": true
    },
    {
      "edgeId": "student_bank_to_next_section_same_page",
      "fromClass": "bankOption",
      "toRole": "next_section",
      "baselineStepRatio": 2,
      "optionalCollapse": false
    },
    {
      "edgeId": "teacher_tail_to_next_section_same_page",
      "fromClass": "teacherTail",
      "toRole": "next_section",
      "baselineStepRatio": 2,
      "optionalCollapse": true
