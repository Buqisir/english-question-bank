# Copy to /etc/eqb-ops-mcp.env on the host. Mode 0640, owner root:eqb-ops.
# Do not commit real values. Auth is fail-closed: the service will not start
# without a Cloudflare Access issuer, audience, and the exact Owner email.

EQB_OPS_MCP_LISTEN=127.0.0.1
EQB_OPS_MCP_PORT=8790
EQB_OPS_MCP_PUBLIC_ORIGIN=https://mcp.eqbank.cc
EQB_OPS_MCP_AUTH_MODE=cloudflare
EQB_OPS_MCP_ALLOWED_EMAIL=bqy2661342736@gmail.com
EQB_OPS_MCP_TEAM_DOMAIN=https://REPLACE_TEAM.cloudflareaccess.com
EQB_OPS_MCP_AUD=REPLACE_ACCESS_AUD

EQB_OPS_MCP_HEALTH_URL=http://127.0.0.1:8787/api/health
EQB_OPS_MCP_SERVICE=eqb
EQB_OPS_MCP_CADDY_SERVICE=caddy
EQB_OPS_MCP_RELEASE_ROOT=/opt/eqb
EQB_OPS_MCP_CHECKOUT=/opt/eqb/english-question-bank
EQB_OPS_MCP_LOG_FILE=/var/lib/eqb-ops/eqb.log
EQB_OPS_MCP_DISK_PATH=/opt/eqb
EQB_OPS_MCP_GIT_BIN=/usr/bin/git
EQB_OPS_MCP_SYSTEMCTL_BIN=/usr/bin/systemctl
