    "group-2022-jia-reading-b": {
      "groupId": "group-2022-jia-reading-b",
      "difficulty": "中",
      "summary": "本文是一篇科普说明文，介绍了一项关于戈芬氏凤头鹦鹉（Goffin's cockatoos）形状识别能力的实验。研究发现这种鹦鹉具备与两岁人类幼儿类似的“以自我为参照系”的空间认知能力，能够通过视觉识别选择正确形状的“钥匙”取出箱中的坚果。",
      "tags": [
        "阅读理解"
      ],
      "displayTitleOverride": "Reading B"
    },
    "group-2022-jia-reading-c": {
      "groupId": "group-2022-jia-reading-c",
      "difficulty": "中",
      "summary": "本文是一篇人物记叙文，讲述71岁的Ginni Bazlinton自幼热爱旅行，退休后独自前往南极的难忘经历，以及这段旅程让她意识到南极是一片应被人类尊重和保护的珍贵土地。",
      "tags": [
        "阅读理解"
      ],
      "displayTitleOverride": "Reading C"
