    "groups": {
      "group-2023-i-reading-a": {
        "overview": "本篇为阿姆斯特丹 MacBike 自行车租赁与导览游的应用文（广告/宣传材料），介绍公司优势、租车价格表以及城市导览游信息。",
        "discourseStructure": {
          "summary": "全文按小标题分块：先欢迎并介绍骑行游城市的体验，再说明选择 MacBike 的理由（规模与车型多样），随后给出价格表，最后介绍导览游的路线、出发地点与时间。",
          "paragraphs": [
            {
              "paragraphId": "para-2023-i-reading-a-1",
              "summary": "总标题：自行车租赁与导览游。",
              "function": "点明文本主题，引出全文。"
            },
            {
              "paragraphId": "para-2023-i-reading-a-2",
              "summary": "欢迎语，强调骑行是探索阿姆斯特丹及周边风光最经济、环保又有趣的方式。",
              "function": "引入并宣传骑行体验，吸引读者。"
            },
            {
              "paragraphId": "para-2023-i-reading-a-3",
              "summary": "小标题：为什么选择 MacBike。",
              "function": "引出公司优势部分。"
            },
            {
              "paragraphId": "para-2023-i-reading-a-4",
              "summary": "介绍 MacBike 近30年历史、是最大租赁公司、五家门店、2500余辆车，并提供多种车型。",
              "function": "陈述公司优势，论证为何选择 MacBike。"
            },
