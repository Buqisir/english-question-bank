      "group-2023-i-reading-b": {
        "overview": "本文是一篇人物记叙说明文，讲述 John Todd 如何从童年观察自然净化污水的现象出发，运用生态学原理设计出 eco-machine 来处理污泥与污水，并将其应用于实际工程，最终提出“生态设计”理念。",
        "discourseStructure": {
          "summary": "全文按时间与逻辑推进：先写童年观察自然引发好奇，再写大学后回到自然提问并决定造机器，接着详述实验过程与惊人结果，随后列举大型实际应用，最后用 John 本人的话点明其“生态设计”核心思想。",
          "paragraphs": [
            {
              "paragraphId": "para-2023-i-reading-b-1",
              "summary": "John 童年喜欢探索树林，观察自然如何解决问题，长大后开始思考能否用这一过程清理人类制造的污染。",
              "function": "引入人物背景与最初的好奇心，提出贯穿全文的核心问题。"
            },
            {
              "paragraphId": "para-2023-i-reading-b-2",
              "summary": "大学学习农业、医学和渔业后，John 回到观察自然、不断提问，设想用合适的动植物组合像自然那样清理废物，决定建造 eco-machine。",
              "function": "承接好奇心，展现其探究精神并引出 eco-machine 的构想。"
            },
            {
              "paragraphId": "para-2023-i-reading-b-3",
              "summary": "John 给自己设定去除污泥中有害物质的任务，建造一系列连通的玻璃纤维水箱，放入本地动植物使其形成生态系统，几周后加入污泥。",
              "function": "详述 eco-machine 的搭建与实验步骤。"
            },
            {
              "paragraphId": "para-2023-i-reading-b-4",
              "summary": "动植物把污泥当作食物吃掉，几周内污泥被全部消化，只剩纯净的水，结果令人惊叹。",
              "function": "呈现实验的惊人结果，证明构想成立。"
            },
            {
              "paragraphId": "para-2023-i-reading-b-5",
              "summary": "多年来 John 承担多项大工程，包括处理南伯灵顿 1600 户家庭污水的设施，以及为中国福州设计清理运河水的 eco-machine。",
              "function": "列举实际应用，展示其理念在现实中的推广。"
            },
            {
              "paragraphId": "para-2023-i-reading-b-6",
              "summary": "John 把自己所做的称为“生态设计”，用“地球生命是发明者的备件箱”作比，强调把生物置于新关系中并让系统自我修复。",
              "function": "用人物原话总结其核心思想，升华主题。"
            }
          ]
        }
      },
      "group-2023-i-reading-c": {
        "overview": "本文是一本关于“数字极简主义”(digital minimalism) 的书的前言/导读，作者说明全书的写作目的与章节结构：先论证数字极简主义的哲学基础并提出“数字整理”(digital declutter) 方法，再在第二部分给出可操作的实践工具。",
        "discourseStructure": {
          "summary": "全文按“总—分”展开：先点明全书目的，再依次介绍第一部分（哲学基础 + digital declutter 方法 + 最后一章的实操指导）与第二部分（可持续生活方式与实践工具箱）。",
          "paragraphs": [
            {
              "paragraphId": "para-2023-i-reading-c-1",
              "summary": "开门见山点出本书目的：论证数字极简主义，并教读者如何采纳这一理念。",
              "function": "总起，提出全书写作目的"
            },
            {
              "paragraphId": "para-2023-i-reading-c-2",
              "summary": "说明全书分为两部分，第一部分先讲数字极简主义的哲学基础。",
              "function": "引出结构，介绍第一部分前半内容"
            },
            {
              "paragraphId": "para-2023-i-reading-c-3",
              "summary": "第一部分以介绍 digital declutter 方法收尾：先远离可选线上活动30天，再有选择地加回少量高价值活动。",
              "function": "介绍第一部分提出的方法"
            },
            {
              "paragraphId": "para-2023-i-reading-c-4",
              "summary": "第一部分最后一章指导读者自行进行 digital declutter，并引用2018年1600多人参与的实验，分享参与者的故事与经验教训。",
              "function": "介绍第一部分最后一章内容"
            },
            {
              "paragraphId": "para-2023-i-reading-c-5",
              "summary": "第二部分深入探讨可持续的数字极简生活方式，每章结尾给出一组实践，作为帮助读者构建生活方式的工具箱。",
              "function": "介绍第二部分内容与实践工具的用途"
            }
          ]
        }
      },
      "group-2023-i-reading-d": {
        "overview": "本文是一篇科普说明文，介绍“群体智慧”（wisdom of crowds）效应及Navajas团队对这一经典现象的最新研究。文章先引出经典效应，再解释其内在机制，接着用新研究提出转折，最后通过后续实验探讨群体讨论如何降低误差并展望意义。",
        "discourseStructure": {
          "summary": "全文按“引出经典现象→解释内在逻辑→新研究提出转折→后续实验探究机制并展望”的递进结构展开。",
          "paragraphs": [
            {
              "paragraphId": "para-2023-i-reading-d-1",
              "summary": "1907年Galton发表论文，提出“群体智慧”效应：大量独立估计的平均值有时相当准确。",
              "function": "引入话题，提出经典的“群体智慧”效应。"
            },
            {
              "paragraphId": "para-2023-i-reading-d-2",
              "summary": "解释群体智慧效应的内在逻辑：个体误差有高估有低估，平均后相互抵消，但前提是估计相互独立。",
              "function": "阐释该效应背后的运作机制与前提条件。"
            },
            {
              "paragraphId": "para-2023-i-reading-d-3",
              "summary": "Navajas的新研究提出转折：把人群分成可讨论的小组后，小组平均值比同等数量独立个体的平均值更准确。",
              "function": "用新研究对经典现象提出转折性发现。"
            },
            {
              "paragraphId": "para-2023-i-reading-d-4",
              "summary": "后续实验探究小组讨论中成员的实际做法，发现“分享论据、共同推理”最常见，能整体降低误差，并展望其意义。",
              "function": "深入探究讨论机制并总结研究的潜在意义与态度。"
            }
          ]
        }
      }
    },
