    },
    "group-zj-2026-jan-reading-b": {
      "groupId": "group-zj-2026-jan-reading-b",
      "difficulty": "中",
      "summary": "一位教师以第一人称叙述自己如何把个人爱好（尤其是对汽车的热爱）带入课堂，用以打破学生的错误观念、激发学习兴趣，并在此过程中意外地拉近了师生关系，最终把这一做法发展为自己的教学理念。",
      "tags": [
        "阅读理解"
      ],
      "displayTitleOverride": "Reading B"
    },
    "group-zj-2026-jan-reading-c": {
      "groupId": "group-zj-2026-jan-reading-c",
      "difficulty": "中",
      "summary": "本文是一篇说明文，介绍了一项关于假评论（fake reviews）的研究。文章先指出消费者喜爱评论但很多评论是假的，随后说明研究的实验设计，再呈现研究发现：人们更信任负面评论且容易被假的负面评论欺骗，长度、细节和情感的缺失会增强假评论的可信度，最后指出AI正越来越多地用于撰写假评论，使其更难被识别。",
      "tags": [
        "阅读理解"
      ],
      "displayTitleOverride": "Reading C"
    },
    "group-zj-2026-jan-reading-d": {
      "groupId": "group-zj-2026-jan-reading-d",
      "difficulty": "中",
      "summary": "本文为科普说明文，介绍 Salk Institute 的科学家如何借助原为追踪动物运动而开发的 AI 软件 SLEAP，分析植物根系表型，进而设计能储存更多二氧化碳的“气候拯救植物”，体现了跨学科合作的价值。",
      "tags": [
        "阅读理解"
      ],
      "displayTitleOverride": "Reading D"
    },
    "group-zj-2026-jan-seven-choices": {
      "groupId": "group-zj-2026-jan-seven-choices",
      "difficulty": "中",
      "summary": "本文讨论阅读中的“回读”(regression)现象：区分因走神而回读（浪费时间）与因真正没读懂而回读（合理的修复策略），并给出保持专注、克服回读坏习惯的方法。",
      "tags": [
