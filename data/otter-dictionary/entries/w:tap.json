              "paragraph": 2,
              "paragraphId": "block:paper-gaokao-2025-i:reading-d:2",
              "sentence": 1
            }
          },
          "tier": "gaokao"
        },
        {
          "exampleId": "w:tap#e-a421faf8ba89a400",
          "text": "In a study published Wednesday in Environmental Science & Technology Letters, researchers from China found that boiling tap water for just five minutes – then filtering it after it cools – could remove at least 80 percent of its microplastics.",
