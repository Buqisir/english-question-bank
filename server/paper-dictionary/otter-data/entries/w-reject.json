      "examples": [
        {
          "exampleId": "w:reject#e-e84f756d2d4bf8bd",
          "text": "It’s jaw-dropping how much perfectly good food is thrown away – from “ugly” (but quite eatable) vegetables rejected by grocers to large amounts of uneaten dishes thrown into restaurant garbage cans.",
          "source": {
            "paperId": "paper-gaokao-2022-i",
            "paperTitle": "2022年普通高等学校招生全国统一考试英语（新高考Ⅰ卷）",
            "groupId": "group:paper-gaokao-2022-i:reading-b",
