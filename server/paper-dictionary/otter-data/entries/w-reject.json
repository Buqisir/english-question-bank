            }
          },
          "tier": "gaokao",
          "target": {
            "start": 199,
            "end": 207
          }
        },
        {
          "exampleId": "w:reject#e-a8dbf806db8f5c76",
          "text": "Rejections from magazines carried a sharper pain – they weren’t just rejecting a hobby, but the refined craft she’d worked so hard for!",
          "source": {
            "paperId": "paper-hz-2026-apr-gaosan-quality",
            "paperTitle": "2025学年第二学期杭州市高三年级教学质量检测",
            "groupId": "group:paper-hz-2026-apr-gaosan-quality:reading-b",
