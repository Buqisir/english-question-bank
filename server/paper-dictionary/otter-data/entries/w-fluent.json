          }
        },
        {
          "exampleId": "w:fluent#e-1ab80ab84fee3c8b",
          "text": "“This gives hope that speech BCIs may one day restore communication as fluent and natural as conversational speech.”",
          "source": {
            "paperId": "paper-mock-guangdong-six-school-alliance-2025-10-second",
            "paperTitle": "广东省“六校联盟”2026届高三年级第二次联考英语",
