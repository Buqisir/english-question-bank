      "examples": [
        {
          "exampleId": "w:area#e-8e8a8dd9eedfef18",
          "text": "As the researchers report in Animal Behavior, the bears did best with patterns where the coloured dots did not move and where more of them also took up a larger coloured area.",
          "source": {
            "paperId": "paper-gaokao-2021-eight-provinces-jan",
            "paperTitle": "2021年1月八省联考英语",
            "groupId": "group:paper-gaokao-2021-eight-provinces-jan:reading-d",
            "locator": {
              "paragraph": 4,
              "paragraphId": "block:paper-gaokao-2021-eight-provinces-jan:reading-d:4",
              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 170,
            "end": 174
          }
        },
        {
          "exampleId": "w:area#e-09d9caab6ca351c7",
          "text": "However, the three bears managed to pick out the bigger number of dots even in pairs of patterns where fewer dots took up a larger area.",
          "source": {
            "paperId": "paper-gaokao-2021-eight-provinces-jan",
            "paperTitle": "2021年1月八省联考英语",
            "groupId": "group:paper-gaokao-2021-eight-provinces-jan:reading-d",
            "locator": {
