        {
          "exampleId": "w:print#e-4a9c54cf0be3af0d",
          "text": "Before the wide use of the printing press, books were treasured objects and could be works of art in their own right.",
          "source": {
            "paperId": "paper-gaokao-2023-ii",
            "paperTitle": "2023年普通高等学校招生全国统一考试英语（新课标Ⅱ卷）",
            "groupId": "group:paper-gaokao-2023-ii:reading-c",
            "locator": {
