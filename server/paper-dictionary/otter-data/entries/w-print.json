        },
        {
          "exampleId": "w:print#e-1d23d25886cd9107",
          "text": "It is printed on cloth.",
          "source": {
            "paperId": "paper-gaokao-2024-nine-provinces-jan",
            "paperTitle": "2024年1月九省联考英语",
