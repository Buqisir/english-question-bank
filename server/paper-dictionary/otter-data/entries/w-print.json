          "target": {
            "start": 27,
            "end": 35
          }
        },
        {
          "exampleId": "w:print#e-937f11d5ca83e075",
          "text": "“This exhibition involves the history of printing, art, photography and advertising over 16 decades.",
          "source": {
            "paperId": "paper-gaokao-2024-nine-provinces-jan",
