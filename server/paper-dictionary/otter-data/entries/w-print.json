        "mock": 4
      },
      "folded": false,
      "examples": [
        {
          "exampleId": "w:print#e-b9221009317463d3",
          "text": "From a 21st-century point of view, the printed book is certainly ancient, but it remains as interactive as any battery-powered e-reader.",
          "source": {
            "paperId": "paper-gaokao-2023-ii",
            "paperTitle": "2023年普通高等学校招生全国统一考试英语（新课标Ⅱ卷）",
            "groupId": "group:paper-gaokao-2023-ii:reading-c",
            "locator": {
              "paragraph": 4,
              "paragraphId": "block:paper-gaokao-2023-ii:reading-c:4",
              "sentence": 2
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 39,
            "end": 46
          }
        },
        {
          "exampleId": "w:print#e-dc3341f8ac7782f3",
          "text": "The benefits of print reading particularly shine through when experimenters move from posing simple tasks – like identifying the main idea in a reading passage – to ones that require mental abstraction – such as drawing inferences from a text.",
          "source": {
            "paperId": "paper-gaokao-2024-i",
            "paperTitle": "2024年普通高等学校招生全国统一考试（新课标Ⅰ）英语试题",
            "groupId": "group:paper-gaokao-2024-i:reading-c",
            "locator": {
              "paragraph": 2,
              "paragraphId": "block:paper-gaokao-2024-i:reading-c:2",
              "sentence": 3
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 16,
            "end": 21
          }
        },
        {
          "exampleId": "w:print#e-1faf9d81166e4219",
          "text": "What is a rule for borrowing a print book through ILL?",
          "source": {
            "paperId": "paper-gaokao-2025-zhejiang-jan",
            "paperTitle": "2025年1月普通高等学校招生全国统一考试英语",
