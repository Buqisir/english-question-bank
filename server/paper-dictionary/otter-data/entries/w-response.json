              "sentence": 4
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 71,
            "end": 80
          }
        },
        {
          "exampleId": "w:response#e-20ebdc119450051d",
          "text": "We are tempted by sugary treats because our ancestors lived in a calorie-poor world, and our brains developed a response mechanism to these treats that reflected their value-a feeling of reward and satisfaction.",
          "source": {
            "paperId": "paper-gaokao-2024-zhejiang-jan",
            "paperTitle": "2024年1月浙江高考英语",
            "groupId": "group:paper-gaokao-2024-zhejiang-jan:reading-d",
            "locator": {
