      "examples": [
        {
          "exampleId": "w:response#e-c4ee0842f27c22c0",
          "text": "Simple and relatively harmless household objects can draw extreme fear responses from a bird.",
          "source": {
            "paperId": "paper-gaokao-2024-nine-provinces-jan",
            "paperTitle": "2024年1月九省联考英语",
            "groupId": "group:paper-gaokao-2024-nine-provinces-jan:reading-b",
            "locator": {
              "paragraph": 4,
