              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 112,
            "end": 120
          }
        },
        {
          "exampleId": "w:response#e-387fd61b27979f8f",
          "text": "A similar process is at work in our response to information.",
          "source": {
            "paperId": "paper-gaokao-2024-zhejiang-jan",
            "paperTitle": "2024年1月浙江高考英语",
