      "examples": [
        {
          "exampleId": "w:response#e-e025451b144c550d",
          "text": "Since the effects were small, this may suggest that our creative thinking does not differ that much in response to total silence and 85 decibels of background noise.",
          "source": {
            "paperId": "paper-gaokao-2021-national-b",
            "paperTitle": "2021年普通高等学校招生全国统一考试（全国乙卷）",
            "groupId": "group:paper-gaokao-2021-national-b:reading-d",
