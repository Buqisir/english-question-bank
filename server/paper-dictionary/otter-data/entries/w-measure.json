      "folded": false,
      "examples": [
        {
          "exampleId": "w:measure#e-ce0e597fc0c78b9b",
          "text": "A carbon footprint is the measure of influence our activities have on the environment, in particular climate change.",
          "source": {
            "paperId": "paper-gaokao-2021-eight-provinces-jan",
            "paperTitle": "2021年1月八省联考英语",
            "groupId": "group:paper-gaokao-2021-eight-provinces-jan:reading-b",
            "locator": {
              "paragraph": 1,
              "paragraphId": "block:paper-gaokao-2021-eight-provinces-jan:reading-b:1",
              "sentence": 2
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 26,
            "end": 33
          }
        },
        {
          "exampleId": "w:measure#e-83b8fb03b4735896",
          "text": "The primary footprint is a measure of our direct emissions（排放）of carbon dioxide (CO2) from the burning of fuels, including household energy consumption and transportation.",
          "source": {
            "paperId": "paper-gaokao-2021-eight-provinces-jan",
            "paperTitle": "2021年1月八省联考英语",
            "groupId": "group:paper-gaokao-2021-eight-provinces-jan:reading-b",
            "locator": {
              "paragraph": 3,
              "paragraphId": "block:paper-gaokao-2021-eight-provinces-jan:reading-b:3",
              "sentence": 2
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 27,
            "end": 34
          }
        },
        {
          "exampleId": "w:measure#e-97ac7a00ac512517",
          "text": "Yet the problem, by just about any measure, appears to be getting worse.",
          "source": {
            "paperId": "paper-gaokao-2022-ii",
            "paperTitle": "2022年普通高等学校招生全国统一考试（新高考全国Ⅱ卷）英语",
            "groupId": "group:paper-gaokao-2022-ii:reading-c",
            "locator": {
              "paragraph": 2,
              "paragraphId": "block:paper-gaokao-2022-ii:reading-c:2",
              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 35,
            "end": 42
          }
        }
      ]
    },
    {
      "senseId": "w:measure#s4",
      "pos": "n.",
      "glossZh": "措施",
      "pronunciationId": "w:measure#p-main",
