              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 109,
            "end": 116
          }
        },
        {
          "exampleId": "w:measure#e-f320093ec8af097f",
          "text": "The average peak workload was measured at 103 watts.",
          "source": {
            "paperId": "paper-gaokao-2022-zhejiang-jan",
            "paperTitle": "2022年1月浙江高考英语",
            "groupId": "group:paper-gaokao-2022-zhejiang-jan:reading-c",
            "locator": {
              "paragraph": 3,
