      "examples": [
        {
          "exampleId": "w:measure#e-d58aeb7c735df4ff",
          "text": "Radio tags（标签）on the animals will measure temperature changes.",
          "source": {
            "paperId": "paper-gaokao-2021-ii",
            "paperTitle": "2021年普通高等学校招生全国统一考试（新高考Ⅱ）英语试题",
            "groupId": "group:paper-gaokao-2021-ii:reading-d",
