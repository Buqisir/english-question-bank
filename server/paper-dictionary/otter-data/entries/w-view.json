          },
          "tier": "gaokao",
          "target": {
            "start": 147,
            "end": 153
          }
        },
        {
          "exampleId": "w:view#e-a41fb498fee3d02e",
          "text": "She watched me narrowly as I approached, turning her head to view me with one big eye, then the other.",
          "source": {
