            "end": 18
          }
        },
        {
          "exampleId": "w:view#e-cad4b7914f718c5c",
          "text": "Bring along your camera and enjoy the wonderful views along this well-surfaced forest path.",
          "source": {
            "paperId": "paper-gaokao-2024-ii",
            "paperTitle": "2024年普通高等学校招生全国统一考试英语（新课标II卷）",
