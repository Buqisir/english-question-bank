          },
          "tier": "gaokao",
          "target": {
            "start": 29,
            "end": 33
          }
        },
        {
          "exampleId": "w:view#e-f7fa9f9cf21f9dbd",
          "text": "When you talk with someone who takes a stand, ask them to give you a reason for their view and spell out their argument fully.",
          "source": {
            "paperId": "paper-gaokao-2024-nine-provinces-jan",
            "paperTitle": "2024年1月九省联考英语",
            "groupId": "group:paper-gaokao-2024-nine-provinces-jan:reading-c",
