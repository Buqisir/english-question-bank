        {
          "exampleId": "w:view#e-b8ed6e124ddeedfb",
          "text": "This research overturns the popular view that all human speech sounds were present when human beings evolved around 300,000 years ago.",
          "source": {
            "paperId": "paper-gaokao-2022-i",
            "paperTitle": "2022年普通高等学校招生全国统一考试英语（新高考Ⅰ卷）",
