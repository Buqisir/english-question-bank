      "examples": [
        {
          "exampleId": "w:talk#e-4844b5aee9ef4b8b",
          "text": "Hence this book, Chasing the Sea: Lost Among the Ghosts of Empire in Central Asia, which talks about a road trip from Tashkent to Karakalpakstan, where millions of lives have been destroyed by the slow drying up of the sea.",
          "source": {
            "paperId": "paper-gaokao-2020-i",
            "paperTitle": "2020年普通高等学校招生全国统一考试（新高考Ⅰ）英语试题",
            "groupId": "group:paper-gaokao-2020-i:reading-c",
            "locator": {
              "paragraph": 2,
