      "examples": [
        {
          "exampleId": "w:talk#e-1272c13af86f542a",
          "text": "Talking freely with your doctor can make you feel better and gives your doctor the information she or he needs to give you the best care.",
          "source": {
            "paperId": "paper-gaokao-2020-ii",
            "paperTitle": "2020年普通高等学校招生全国统一考试（新高考Ⅱ）英语试题",
            "groupId": "group:paper-gaokao-2020-ii:seven-choices",
            "locator": {
              "paragraph": 2,
              "paragraphId": "block:paper-gaokao-2020-ii:seven-choices:2",
              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 0,
            "end": 7
          }
        },
        {
          "exampleId": "w:talk#e-2d5b136a263ddbd3",
          "text": "Many students say they will talk to their friend or classmates because they're of the same age and can understand each other.",
          "source": {
            "paperId": "paper-gaokao-2021-national-a",
            "paperTitle": "2021年普通高等学校招生全国统一考试（全国甲卷）",
            "groupId": "group:paper-gaokao-2021-national-a:writing-short-error-correction",
            "locator": {
              "paragraph": 8,
              "paragraphId": "block:paper-gaokao-2021-national-a:writing-short-error-correction:8",
              "sentence": 4
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 28,
            "end": 32
          }
        },
        {
          "exampleId": "w:talk#e-85ae8387cb09138a",
          "text": "So the main thing is just to show up and be adventurous, trying different foods and talking to strangers.",
          "source": {
            "paperId": "paper-gaokao-2021-national-b",
            "paperTitle": "2021年普通高等学校招生全国统一考试（全国乙卷）",
            "groupId": "group:paper-gaokao-2021-national-b:seven-choices",
            "locator": {
              "paragraph": 2,
