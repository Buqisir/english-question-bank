        },
        {
          "exampleId": "w:speak#e-bf58b900bcd36c47",
          "text": "What do most people think is very important in spoken communication?",
          "source": {
            "paperId": "paper-gaokao-2021-i",
            "paperTitle": "2021年普通高等学校招生全国统一考试英语",
