      "examples": [
        {
          "exampleId": "w:consume#e-b0d48a0d5942d88d",
          "text": "The amazing food is mainly consumed by local farmers.",
          "source": {
            "paperId": "paper-gaokao-2021-i",
            "paperTitle": "2021年普通高等学校招生全国统一考试英语",
            "groupId": "group:paper-gaokao-2021-i:seven-choices",
            "locator": {
              "question": 36,
              "questionId": "question:paper-gaokao-2021-i:36",
              "option": "D",
              "sentence": 1
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 27,
            "end": 35
          }
        },
        {
          "exampleId": "w:consume#e-149b7a1b3cec8fd0",
          "text": "It is believed that today’s children and teenagers are consuming three times the recommended level of sugar, putting them at a higher risk of the disease.",
          "source": {
            "paperId": "paper-gaokao-2022-national-b",
            "paperTitle": "2022 年普通高等学校招生全国统一考试英语（全国乙卷）",
            "groupId": "group:paper-gaokao-2022-national-b:reading-d",
            "locator": {
