              "sentence": 2
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 72,
            "end": 77
          }
        },
        {
          "exampleId": "w:power#e-9dce4cb75a2fd956",
          "text": "Eschewing fertilizers（化肥）and power tools, it’s based on an elegantly simple principle: to garden more like nature does.",
          "source": {
            "paperId": "paper-gaokao-2025-zhejiang-jan",
            "paperTitle": "2025年1月普通高等学校招生全国统一考试英语",
            "groupId": "group:paper-gaokao-2025-zhejiang-jan:reading-c",
