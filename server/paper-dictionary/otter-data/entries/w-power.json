        {
          "exampleId": "w:power#e-726af4b9b6bd5542",
          "text": "He is building a four-wheeled robot that will run on solar and electric power.",
          "source": {
            "paperId": "paper-gaokao-2021-ii",
            "paperTitle": "2021年普通高等学校招生全国统一考试（新高考Ⅱ）英语试题",
            "groupId": "group:paper-gaokao-2021-ii:reading-d",
            "locator": {
              "paragraph": 2,
