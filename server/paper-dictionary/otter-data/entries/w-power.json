              "paragraph": 1,
              "paragraphId": "block:paper-gaokao-2025-zhejiang-jan:reading-c:1",
              "sentence": 3
            }
          },
          "tier": "gaokao",
          "target": {
            "start": 29,
            "end": 34
          }
        },
        {
          "exampleId": "w:power#e-1a53eca3bb5bd592",
          "text": "In 2017, they bought two empty lands and started a commercial flower farm, using rainwater and solar power, with no chemicals.",
          "source": {
            "paperId": "paper-mock-chongqing-kangde-2026-05-may-survey-r3",
            "paperTitle": "重庆市康德2026年普通高等学校招生全国统一考试5月调研英语试题",
