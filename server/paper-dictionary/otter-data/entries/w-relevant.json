            "end": 113
          }
        },
        {
          "exampleId": "w:relevant#e-5e0b7b304328b6de",
          "text": "I’ve discovered that if I show students how what they learn is relevant to my hobbies, they’re much more willing to make connections to their personal interests and develop their own hobbies.",
          "source": {
            "paperId": "paper-gaokao-2026-zhejiang-jan",
