        {
          "exampleId": "w:central#e-54328f348509c9ed",
          "text": "Each play has a theme or central idea which the playwright(剧作家) hopes to get across through dialogue and action.",
          "source": {
            "paperId": "paper-gaokao-2020-zhejiang-jul",
            "paperTitle": "2020 年 7 月浙江高考英语",
            "groupId": "group:paper-gaokao-2020-zhejiang-jul:reading-a",
