  "schemaVersion": "reading-vertical-rhythm-reference-measurements-v3",
  "authority": {
    "readme": "docs/product/exam-paper-format-reference/README.md",
    "standard": "docs/product/exam-paper-format-standards.md",
    "goldenPages": ["G03", "G04", "G05", "G06", "G07", "G08"],
    "measurementMethod": "Tesseract 5.5.2 --psm 6 TSV word boxes on the exact digest-bound JPEG bytes. Each line baseline proxy is the median lower edge of ordinary-height Latin word boxes on that semantic line. Each distance is divided by the median nearby Latin baseline step from the same crop before any renderer target is selected.",
    "coordinateSystem": "JPEG pixels from top-left; recorded coordinates are line baseline proxies only.",
    "scaleBoundary": "JPEG coordinates are used only inside one crop to form dimensionless local ratios. JPEG pixels are never treated as Screen CSS pixels or PDF points, and no scale is inferred from a full A4 page.",
    "renderedMappingMethod": "Multiply a dimensionless adjacency ratio by the actual public artifact baseline step: computed 24px on Screen and measured 18pt in exact-A4 Chromium PDF.",
    "semanticBoundary": "The oracle names visible semantic roles and exact source-text anchors. It does not copy renderer DOM order or the production heading-selection algorithm."
  },
  "tolerances": {
    "horizontalImageCenterOffsetPx": 12,
    "letterGlyphHeightPx": 1,
    "localBaselineStepPx": 1,
    "letterRatio": 0.05,
    "oneStepRatio": 0.15,
    "twoStepRatio": 0.15,
    "screenHorizontalCenterPx": 0.5,
    "screenOneStepPx": 1.25,
    "screenTwoStepPx": 1.5,
    "pdfHorizontalCenterPt": 0.5,
    "pdfOneStepPt": 1.5,
    "pdfTwoStepPt": 1.5
  },
  "toleranceDerivation": {
    "method": "For each normalized adjacency class, take the largest absolute residual among the recorded local-ratio samples, then round upward to the next 0.05 ratio step. Letter edges retain the tighter prior 0.05 gate because all four direct letter samples fall within it. Renderer tolerances add only the public artifact extractor's observed sub-pixel or sub-point box uncertainty; PDF mixed-glyph comparisons use extracted text-box vertical centers as the baseline proxy so glyph ascender and descender shapes cannot change the result. Tolerances are not copied CSS constants.",
    "oneStepLargestRecordedResidual": 0.129032,
    "oneStepRoundedTolerance": 0.15,
    "twoStepLargestRecordedResidual": 0.096774,
    "twoStepRoundedTolerance": 0.15,
    "letterLargestRecordedResidual": 0.032258,
    "letterRoundedTolerance": 0.05,
    "pdfOneStepLargestExtractorResidualPt": 1.288261,
    "pdfOneStepRoundedTolerancePt": 1.5,
    "pdfTwoStepLargestExtractorResidualPt": 1.288261,
    "pdfTwoStepRoundedTolerancePt": 1.5
  },
