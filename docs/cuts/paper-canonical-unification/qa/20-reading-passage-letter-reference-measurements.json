{
  "schemaVersion": "reading-passage-letter-reference-measurements-v2",
  "authority": {
    "readme": "docs/product/exam-paper-format-reference/README.md",
    "standard": "docs/product/exam-paper-format-standards.md",
    "measurementMethod": "Tesseract 5.5.2 --psm 6 TSV word boxes on the exact digest-bound JPEG bytes. Local scale is the median step between nearby Latin-line baseline proxies in the same crop; a line baseline proxy is the median lower edge of its ordinary-height Latin word boxes, excluding taller Chinese gloss or descender outliers. Passage-letter distances are divided by that local step before any renderer target is selected.",
    "coordinateSystem": "JPEG pixels from top-left; boxes are x,y,width,height; baselineProxyY is the selected median Latin glyph-box lower edge.",
    "scaleBoundary": "JPEG pixels are used only inside each crop to form dimensionless ratios. No JPEG pixel is treated as a Screen CSS pixel or converted to a PDF point.",
    "renderedMappingMethod": "Multiply the dimensionless golden ratio by the actual public artifact's fixed body baseline step: computed 24px on Screen and measured 18pt in exact A4 Chromium PDF."
  },
  "tolerances": {
    "horizontalImageCenterOffsetPx": 12,
    "letterGlyphHeightPx": 1,
    "localBaselineStepPx": 1,
    "goldenBaselineStepRatio": 0.05,
    "screenHorizontalCenterPx": 0.5,
    "screenFollowingBaselineStepPx": 0.75,
    "screenPrecedingBaselineStepPx": 1.25,
    "pdfHorizontalCenterPt": 0.5,
    "pdfFollowingBaselineStepPt": 0.5,
    "pdfPrecedingBaselineStepPt": 1
  },
  "normalizedContract": {
    "letterGlyphHeightPx": 13,
    "scaleReference": "median nearby Latin baseline-proxy step in the same digest-bound crop",
    "headingToLetterBaselineStepRatio": 1,
    "priorContentToLetterBaselineStepRatio": 2,
    "letterToFirstPassageBaselineStepRatio": 1,
    "screen": {
      "observedBodyBaselineStepPx": 24,
      "headingToLetterTargetPx": 24,
      "priorContentToLetterTargetPx": 48,
      "letterToFirstPassageTargetPx": 24,
      "formula": "targetPx = goldenBaselineStepRatio * observedBodyBaselineStepPx"
    },
    "printPdf": {
      "observedBodyBaselineStepPt": 18,
      "headingToLetterTargetPt": 18,
      "priorContentToLetterTargetPt": 36,
      "letterToFirstPassageTargetPt": 18,
      "formula": "targetPt = goldenBaselineStepRatio * observedBodyBaselineStepPt"
    },
    "extraLetterToPassageMargin": "none"
  },
